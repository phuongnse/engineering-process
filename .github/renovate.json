{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabled": true,
  "automerge": false,
  "branchPrefix": "automation/renovate/",
  "dependencyDashboard": false,
  "rangeStrategy": "pin",
  "constraints": {
    "pipTools": "==7.6.1",
    "python": "==3.14"
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements\\/process\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "packageRules": [
    {
      "description": "Reserve engineering-process adoption for the pre-publication lifecycle host",
      "matchFileNames": [
        "requirements/process.in",
        "requirements/process.txt"
      ],
      "matchPackageNames": [
        "engineering-process"
      ],
      "enabled": false,
      "automerge": false,
      "groupName": "engineering-process authority",
      "schedule": ["at any time"],
      "prPriority": 100,
      "commitMessageTopic": "engineering-process authority"
    }
  ]
}
