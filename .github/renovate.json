{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>phuongnse/engineering-process//templates/renovate#71bb94acb18aab41c97120f66e3cbd7c2fcee468"
  ],
  "enabled": true,
  "draftPR": true,
  "branchPrefix": "automation/renovate/",
  "dependencyDashboard": false,
  "rangeStrategy": "pin",
  "constraints": {
    "pipTools": "==7.6.1",
    "python": "==3.14"
  },
  "pip-compile": {
    "managerFilePatterns": ["/^requirements\\/process\\.txt$/"]
  },
  "pip_requirements": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Keep the supported Python range under consumer control",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "description": "Adopt each published engineering-process release as a complete managed pull request",
      "matchManagers": ["pip-compile"],
      "matchFileNames": [
        "requirements/process.in",
        "requirements/process.txt"
      ],
      "matchPackageNames": ["engineering-process"],
      "enabled": true,
      "draftPR": true,
      "groupName": "engineering-process",
      "schedule": ["at any time"],
      "prPriority": 100,
      "commitMessageTopic": "engineering-process",
      "postUpgradeTasks": {
        "commands": [
          "python .process/adopt-process.py --project-root . --requirements-lock requirements/process.txt"
        ],
        "fileFilters": [
          ".agents/skills/**",
          ".github/PULL_REQUEST_TEMPLATE.md",
          ".process/adopt-process.py",
          ".process/automation.json",
          ".process/adopt-process-windows-job.py",
          ".process/adoption-migrations/**",
          ".process/process.lock",
          ".process/project.json",
          "AGENTS.md"
        ],
        "executionMode": "update",
        "installTools": {
          "python": {}
        }
      }
    }
  ]
}
