{
  "lifecycle": {
    "processChanges": {
      "acceptedIssueUrlPrefix": "https://github.com/phuongnse/engineering-process/issues/",
      "requireConsumerEvidence": true
    },
    "publication": {
      "required": true
    },
    "requiredProfiles": [
      "development",
      "review"
    ]
  },
  "profiles": {
    "development": [
      {
        "id": "unit-and-contract-tests",
        "run": [
          "python",
          "verification/run_test_suite.py"
        ],
        "timeoutSeconds": 1800
      }
    ],
    "review": [
      {
        "id": "release-contents",
        "run": [
          "python",
          "verification/render_release_notes.py",
          "--check",
          "RELEASE_NOTES.md"
        ],
        "timeoutSeconds": 60
      },
      {
        "id": "publication-branch",
        "run": [
          "python",
          "verification/verify_publication.py"
        ],
        "timeoutSeconds": 60
      },
      {
        "id": "portable-skills",
        "run": [
          "python",
          "processctl.py",
          "skills",
          "validate",
          "--root",
          "process_assets/skills"
        ],
        "timeoutSeconds": 300
      },
      {
        "id": "distribution-build",
        "run": [
          "python",
          "verification/verify_distribution.py"
        ],
        "timeoutSeconds": 900
      }
    ]
  },
  "impactProfiles": {
    "schemaVersion": 1,
    "profiles": {
      "development": [
      {
        "id": "lifecycle",
        "run": ["python", "verification/run_test_suite.py", "--module", "tests.test_lifecycle", "--module", "tests.test_review_contexts"],
        "timeoutSeconds": 1200,
        "paths": [
          "engineering_process/lifecycle.py",
          "engineering_process/review_contexts.py",
          "engineering_process/source_publication.py",
          "tests/test_lifecycle.py",
          "tests/test_review_contexts.py"
        ]
      },
      {
        "id": "commands",
        "run": ["python", "verification/run_test_suite.py", "--module", "tests.test_commands", "--module", "tests.test_cli", "--module", "tests.test_contracts", "--module", "tests.test_supervisor_posix", "--module", "tests.test_impact"],
        "timeoutSeconds": 1200,
        "paths": [
          "engineering_process/commands.py",
          "engineering_process/cli.py",
          "engineering_process/contracts.py",
          "engineering_process/evidence.py",
          "engineering_process/impact.py",
          "engineering_process/project.py",
          "engineering_process/supervision.py",
          "engineering_process/_supervisor_*.py",
          "tests/test_commands.py",
          "tests/test_cli.py",
          "tests/test_contracts.py",
          "tests/test_supervisor_posix.py",
          "tests/test_impact.py"
        ]
      },
      {
        "id": "repository",
        "run": ["python", "verification/run_test_suite.py", "--module", "tests.test_repository"],
        "timeoutSeconds": 600,
        "paths": ["engineering_process/repository.py", "tests/test_repository.py"]
      },
      {
        "id": "artifacts",
        "run": ["python", "verification/run_test_suite.py", "--module", "tests.test_artifact_standards", "--module", "tests.test_publication_compat", "--module", "tests.test_publication_workflow"],
        "timeoutSeconds": 1200,
        "paths": [
          "engineering_process/artifact_standards.py",
          "engineering_process/issue.py",
          "engineering_process/pr_description.py",
          "engineering_process/publication_compat.py",
          "tests/test_artifact_standards.py",
          "tests/test_publication_compat.py",
          "tests/test_publication_workflow.py"
        ]
      },
      {
        "id": "release",
        "run": ["python", "verification/run_test_suite.py", "--module", "tests.test_release"],
        "timeoutSeconds": 1200,
        "paths": [
          "engineering_process/release.py",
          "engineering_process/release_notes.py",
          "verification/prepare_release.py",
          "verification/render_release_notes.py",
          "tests/test_release.py",
          "release.json",
          "RELEASE_NOTES.md",
          "release-changes/**"
        ]
      },
      {
        "id": "adoption",
        "run": ["python", "verification/run_test_suite.py", "--module", "tests.test_adoption", "--module", "tests.test_distribution", "--module", "tests.test_skills"],
        "timeoutSeconds": 1200,
        "paths": [
          "engineering_process/adoption.py",
          "engineering_process/distribution.py",
          "engineering_process/skills.py",
          "process_assets/skills/**",
          "process_assets/standards/**",
          ".agents/skills/**",
          "tests/test_adoption.py",
          "tests/test_distribution.py",
          "tests/test_skills.py"
        ]
      },
      {
        "id": "production",
        "run": ["python", "verification/run_test_suite.py", "--module", "tests.test_production_engineering", "--module", "tests.test_architecture"],
        "timeoutSeconds": 900,
        "paths": [
          "engineering_process/production_engineering.py",
          "tests/test_production_engineering.py",
          "tests/test_architecture.py"
        ]
      },
      {
        "id": "automation",
        "run": ["python", "verification/run_test_suite.py", "--module", "tests.test_automation", "--module", "tests.test_pypi_cache"],
        "timeoutSeconds": 900,
        "paths": [
          "engineering_process/automation_name.py",
          "tests/test_automation.py",
          "tests/test_pypi_cache.py"
        ]
      },
      {
        "id": "documentation",
        "run": ["python", "processctl.py", "project", "validate"],
        "timeoutSeconds": 60,
        "paths": [
          "README.md",
          "AGENTS.md",
          "ARTIFACT_STANDARDS.md",
          "PROCESS_IMPROVEMENT.md",
          "RELEASING.md",
          "SELF_HOSTING.md",
          "VERSIONING.md"
        ]
      },
      {
        "id": "global-contract",
        "run": ["python", "verification/run_test_suite.py"],
        "timeoutSeconds": 1800,
        "scope": "global",
        "paths": [
          ".github/**",
          ".process/project.json",
          "MANIFEST.in",
          "processctl.py",
          "pyproject.toml",
          "engineering_process/__init__.py",
          "engineering_process/requirements-*.txt",
          "requirements/**",
          "schemas/**",
          "templates/**",
          "verification/run_test_suite.py"
        ]
      }
      ],
      "review": [
      {
        "id": "release-contents",
        "run": ["python", "verification/render_release_notes.py", "--check", "RELEASE_NOTES.md"],
        "timeoutSeconds": 60,
        "paths": ["release.json", "RELEASE_NOTES.md", "release-changes/**", "verification/prepare_release.py", "verification/render_release_notes.py"]
      },
      {
        "id": "publication-branch",
        "run": ["python", "verification/verify_publication.py"],
        "timeoutSeconds": 60,
        "paths": ["**"]
      },
      {
        "id": "portable-skills",
        "run": ["python", "processctl.py", "skills", "validate", "--root", "process_assets/skills"],
        "timeoutSeconds": 300,
        "paths": ["process_assets/skills/**", ".agents/skills/**", "README.md", "SELF_HOSTING.md", "VERSIONING.md"]
      },
      {
        "id": "distribution-build",
        "run": ["python", "verification/verify_distribution.py"],
        "timeoutSeconds": 900,
        "paths": ["engineering_process/**", "schemas/**", "process_assets/**", "templates/**", "pyproject.toml", "MANIFEST.in", "README.md", "RELEASE_NOTES.md", "verification/verify_distribution.py"]
      }
      ]
    }
  },
  "project": "engineering-process",
  "schemaVersion": 5
}
