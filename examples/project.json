{
  "schemaVersion": 3,
  "project": "sample-project",
  "lifecycle": {
    "requiredProfiles": ["development", "review"]
  },
  "impact": {
    "baseRefs": ["origin/main", "main"],
    "unmatchedPaths": "all-scoped-checks",
    "components": [
      {
        "id": "docs",
        "paths": ["**/*.md"],
        "affects": []
      },
      {
        "id": "source",
        "paths": ["**/*.py", "pyproject.toml"],
        "affects": []
      }
    ]
  },
  "profiles": {
    "development": [
      {
        "id": "unit",
        "run": ["python", "-m", "unittest"],
        "timeoutSeconds": 600,
        "components": ["source"]
      }
    ],
    "review": [
      {
        "id": "full",
        "run": ["python", "-m", "unittest", "discover"],
        "timeoutSeconds": 1800,
        "components": ["docs", "source"]
      }
    ]
  },
  "environment": {
    "defaultProfile": "development",
    "foregroundOnly": true,
    "managedTools": [],
    "profiles": {
      "development": [
        "python-runtime"
      ],
      "review": [
        "python-runtime"
      ]
    },
    "requirements": [
      {
        "id": "python-runtime",
        "description": "Supported CPython runtime",
        "probe": {
          "run": [
            "python",
            "--version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "combined",
          "outputRegex": "^Python 3\\.(?:11|12|13|14)\\."
        },
        "remediation": "Install a supported Python runtime before running processctl."
      }
    ],
    "setupActions": []
  }
}
