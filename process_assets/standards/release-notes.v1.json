{
  "schemaVersion": 1,
  "id": "process.release-notes",
  "version": 1,
  "artifact": "release-notes",
  "adapter": "release-notes",
  "pendingValues": [
    "pending",
    "pending...",
    "pending…"
  ],
  "rules": {
    "groups": [
      {
        "type": "breaking",
        "heading": "Breaking changes"
      },
      {
        "type": "capability",
        "heading": "Features"
      },
      {
        "type": "fix",
        "heading": "Fixes"
      }
    ],
    "sections": [
      {
        "id": "upgrade",
        "heading": "Upgrade and compatibility"
      }
    ]
  }
}
