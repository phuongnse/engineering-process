{
  "schemaVersion": 1,
  "id": "process.release-notes",
  "version": 1,
  "artifact": "release-notes",
  "adapter": "release-notes",
  "pendingValues": [
    "pending",
    "pending...",
    "pending…"
  ],
  "rules": {
    "groups": [
      {
        "type": "breaking",
        "heading": "Breaking changes"
      },
      {
        "type": "capability",
        "heading": "Features"
      },
      {
        "type": "fix",
        "heading": "Fixes"
      }
    ],
    "sections": [
      {
        "id": "upgrade",
        "heading": "Upgrade and compatibility"
      }
    ],
    "detailLabels": {
      "problem": "Why it matters",
      "changes": "Result",
      "affectedPaths": "Surfaces",
      "apply": "Adopt",
      "compatibility": "Impact",
      "notes": "Caveats"
    },
    "detailFields": {
      "breaking": ["problem", "changes", "apply", "compatibility"],
      "capability": ["changes", "apply", "compatibility"],
      "fix": ["changes", "compatibility"]
    }
  }
}
