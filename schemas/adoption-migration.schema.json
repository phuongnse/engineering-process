{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/adoption-migration.schema.json",
  "title": "Engineering process consumer adoption migration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fromProcessVersion",
    "toProcessVersion",
    "sourceProjectDigest",
    "targetProjectDigest",
    "project"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "fromProcessVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "toProcessVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sourceProjectDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "targetProjectDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "project": {
      "type": "object"
    }
  }
}
