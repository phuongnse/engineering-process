{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/artifact-standard.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "artifact",
    "adapter",
    "pendingValues",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "artifact": {
      "$ref": "#/$defs/id"
    },
    "adapter": {
      "enum": [
        "pr-description",
        "release-notes"
      ]
    },
    "pendingValues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/line"
      },
      "uniqueItems": true
    },
    "rules": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "adapter": {
            "const": "pr-description"
          }
        }
      },
      "then": {
        "properties": {
          "rules": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sections",
              "issueReferences"
            ],
            "properties": {
              "sections": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "heading",
                    "fields",
                    "checks"
                  ],
                  "properties": {
                    "heading": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000,
                      "pattern": "^## [^ ]",
                      "not": {
                        "pattern": "[\\r\\n\\v\\f\\u0085\\u2028\\u2029]"
                      }
                    },
                    "fields": {
                      "type": "array",
                      "minItems": 0,
                      "maxItems": 32,
                      "items": {
                        "$ref": "#/$defs/field"
                      }
                    },
                    "checks": {
                      "type": "array",
                      "minItems": 0,
                      "maxItems": 32,
                      "items": {
                        "$ref": "#/$defs/check"
                      }
                    }
                  },
                  "anyOf": [
                    {
                      "properties": {
                        "fields": {
                          "minItems": 1
                        }
                      }
                    },
                    {
                      "properties": {
                        "checks": {
                          "minItems": 1
                        }
                      }
                    }
                  ]
                }
              },
              "issueReferences": {
                "type": "boolean"
              },
              "guidance": {
                "type": "string",
                "maxLength": 20000
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "rules": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "groups",
              "sections"
            ],
            "properties": {
              "groups": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "heading"
                  ],
                  "properties": {
                    "type": {
                      "$ref": "#/$defs/id"
                    },
                    "heading": {
                      "$ref": "#/$defs/line"
                    }
                  }
                }
              },
              "sections": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "heading"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "heading": {
                      "$ref": "#/$defs/line"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S",
      "not": {
        "pattern": "[\\r\\n\\v\\f\\u0085\\u2028\\u2029]"
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/line"
        },
        "description": {
          "$ref": "#/$defs/line"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/line"
        }
      }
    }
  }
}
