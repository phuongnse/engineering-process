{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/automation-policy.schema.json",
  "title": "Standing gated automation policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "enabled",
    "confirmationMode",
    "actions",
    "merge",
    "escalationReasons"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "engineering-process-standing-automation-policy"},
    "enabled": {"const": true},
    "confirmationMode": {"const": "exceptions-only"},
    "actions": {
      "const": [
        "adopt",
        "commit",
        "deploy",
        "ephemeral-cleanup",
        "merge",
        "publish",
        "push",
        "release",
        "review-object"
      ]
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "requireCompletedLifecycle",
        "requireCurrentBase",
        "requireExactHead",
        "requireIndependentReview",
        "requireRequiredChecks"
      ],
      "properties": {
        "method": {"enum": ["merge", "rebase", "squash"]},
        "requireCompletedLifecycle": {"const": true},
        "requireCurrentBase": {"const": true},
        "requireExactHead": {"const": true},
        "requireIndependentReview": {"const": true},
        "requireRequiredChecks": {"const": true}
      }
    },
    "escalationReasons": {
      "const": [
        "bounded-recovery-exhausted",
        "capability-unavailable",
        "decision-required"
      ]
    }
  }
}
