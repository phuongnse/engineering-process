{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/automation-proposal-policy.schema.json",
  "title": "Controlled automation-proposal protected-base opt-in policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "enabled",
    "targetBranch",
    "branchPrefix",
    "completionCheck",
    "allowedAutomationOwners",
    "allowedProposalKinds",
    "requiredControls"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"enum": [1, 2, 3]},
    "kind": {"const": "engineering-process-automation-proposal-policy"},
    "enabled": {"const": true},
    "targetBranch": {"$ref": "#/$defs/ref"},
    "branchPrefix": {
      "type": "string",
      "pattern": "^automation/[a-z0-9]+(?:-[a-z0-9]+)*/$",
      "maxLength": 128
    },
    "completionCheck": {"enum": ["lifecycle-completion", "consumer-owner-merge"]},
    "allowedAutomationOwners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "allowedProposalKinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["dependency-update", "process-adoption"]}
    },
    "requiredControls": {
      "oneOf": [
        {"$ref": "#/$defs/legacyControls"},
        {"$ref": "#/$defs/adoptionControls"}
      ]
    },
    "verifier": {"$ref": "#/$defs/verifier"}
  },
  "$defs": {
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!-)[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "repository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "commit": {"$ref": "#/$defs/gitOid"}
      }
    },
    "legacyControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automerge", "scripts", "plugins", "shellExecution", "privilegedCi",
        "writeCapableChecks", "processAuthorityChanges", "workflowChanges",
        "releaseChanges", "deploymentChanges", "securityPolicyChanges",
        "trustRootChanges", "upToDateBeforeMerge", "humanMergeRequired"
      ],
      "properties": {
        "automerge": {"const": false},
        "scripts": {"const": false},
        "plugins": {"const": false},
        "shellExecution": {"const": false},
        "privilegedCi": {"const": false},
        "writeCapableChecks": {"const": false},
        "processAuthorityChanges": {"const": false},
        "workflowChanges": {"const": false},
        "releaseChanges": {"const": false},
        "deploymentChanges": {"const": false},
        "securityPolicyChanges": {"const": false},
        "trustRootChanges": {"const": false},
        "upToDateBeforeMerge": {"const": true},
        "humanMergeRequired": {"type": "boolean"}
      }
    },
    "adoptionControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automerge", "scripts", "plugins", "shellExecution", "privilegedCi",
        "writeCapableChecks", "processAuthorityChanges", "workflowChanges",
        "releaseChanges", "deploymentChanges", "securityPolicyChanges",
        "trustRootChanges", "upToDateBeforeMerge", "consumerOwnerMergeRequired",
        "postMergeMutation"
      ],
      "properties": {
        "automerge": {"const": false},
        "scripts": {"const": false},
        "plugins": {"const": false},
        "shellExecution": {"const": false},
        "privilegedCi": {"const": false},
        "writeCapableChecks": {"const": false},
        "processAuthorityChanges": {"const": true},
        "workflowChanges": {"const": true},
        "releaseChanges": {"const": false},
        "deploymentChanges": {"const": false},
        "securityPolicyChanges": {"const": false},
        "trustRootChanges": {"const": false},
        "upToDateBeforeMerge": {"const": true},
        "consumerOwnerMergeRequired": {"const": true},
        "postMergeMutation": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 1}}, "required": ["schemaVersion"]},
      "then": {
        "not": {"required": ["verifier"]},
        "properties": {
          "completionCheck": {"const": "lifecycle-completion"},
          "allowedProposalKinds": {"items": {"const": "dependency-update"}},
          "requiredControls": {
            "allOf": [
              {"$ref": "#/$defs/legacyControls"},
              {"properties": {"humanMergeRequired": {"const": true}}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"schemaVersion": {"const": 2}}, "required": ["schemaVersion"]},
      "then": {
        "not": {"required": ["verifier"]},
        "properties": {
          "completionCheck": {"const": "lifecycle-completion"},
          "allowedProposalKinds": {"items": {"const": "dependency-update"}},
          "requiredControls": {
            "allOf": [
              {"$ref": "#/$defs/legacyControls"},
              {"properties": {"humanMergeRequired": {"const": false}}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"schemaVersion": {"const": 3}}, "required": ["schemaVersion"]},
      "then": {
        "required": ["verifier"],
        "properties": {
          "completionCheck": {"const": "consumer-owner-merge"},
          "branchPrefix": {"const": "automation/renovate/"},
          "allowedAutomationOwners": {"items": {"const": "renovate"}},
          "allowedProposalKinds": {"items": {"const": "process-adoption"}},
          "requiredControls": {"$ref": "#/$defs/adoptionControls"}
        }
      }
    }
  ]
}
