{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/automation-proposal-policy.schema.json",
  "title": "Controlled automation-proposal protected-base opt-in policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "enabled",
    "targetBranch",
    "branchPrefix",
    "completionCheck",
    "allowedAutomationOwners",
    "allowedProposalKinds",
    "requiredControls"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "engineering-process-automation-proposal-policy"},
    "enabled": {"const": true},
    "targetBranch": {"$ref": "#/$defs/ref"},
    "branchPrefix": {
      "type": "string",
      "pattern": "^automation/[a-z0-9]+(?:-[a-z0-9]+)*/$",
      "maxLength": 128
    },
    "completionCheck": {"const": "lifecycle-completion"},
    "allowedAutomationOwners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "allowedProposalKinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"const": "dependency-update"}
    },
    "requiredControls": {"$ref": "#/$defs/controls"}
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!-)[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automerge",
        "scripts",
        "plugins",
        "shellExecution",
        "privilegedCi",
        "writeCapableChecks",
        "processAuthorityChanges",
        "workflowChanges",
        "releaseChanges",
        "deploymentChanges",
        "securityPolicyChanges",
        "trustRootChanges",
        "upToDateBeforeMerge",
        "humanMergeRequired"
      ],
      "properties": {
        "automerge": {"const": false},
        "scripts": {"const": false},
        "plugins": {"const": false},
        "shellExecution": {"const": false},
        "privilegedCi": {"const": false},
        "writeCapableChecks": {"const": false},
        "processAuthorityChanges": {"const": false},
        "workflowChanges": {"const": false},
        "releaseChanges": {"const": false},
        "deploymentChanges": {"const": false},
        "securityPolicyChanges": {"const": false},
        "trustRootChanges": {"const": false},
        "upToDateBeforeMerge": {"const": true},
        "humanMergeRequired": {"const": true}
      }
    }
  }
}
