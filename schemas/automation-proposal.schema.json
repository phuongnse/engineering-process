{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/automation-proposal.schema.json",
  "title": "Controlled automation-proposal policy evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "repository",
    "proposalKind",
    "automationOwner",
    "branch",
    "targetBranch",
    "baseSha",
    "headSha",
    "title",
    "bodySha256",
    "changedPaths",
    "optIn",
    "verifier",
    "observedControls"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "engineering-process-controlled-automation-proposal"},
    "status": {"const": "passed"},
    "repository": {"$ref": "#/$defs/repository"},
    "proposalKind": {"const": "dependency-update"},
    "automationOwner": {"$ref": "#/$defs/name"},
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^automation/[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$"
    },
    "targetBranch": {"$ref": "#/$defs/ref"},
    "baseSha": {"$ref": "#/$defs/gitOid"},
    "headSha": {"$ref": "#/$defs/gitOid"},
    "title": {"type": "string", "minLength": 1, "maxLength": 72},
    "bodySha256": {"$ref": "#/$defs/digest"},
    "changedPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/path"}
    },
    "optIn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "document"],
      "properties": {
        "path": {"const": ".process/automation-proposals.json"},
        "sha256": {"$ref": "#/$defs/digest"},
        "document": {"$ref": "#/$defs/policy"}
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "commit": {"$ref": "#/$defs/gitOid"}
      }
    },
    "observedControls": {"$ref": "#/$defs/controls"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:])[ -~]+$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!-)[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "repository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automerge",
        "scripts",
        "plugins",
        "shellExecution",
        "privilegedCi",
        "writeCapableChecks",
        "processAuthorityChanges",
        "workflowChanges",
        "releaseChanges",
        "deploymentChanges",
        "securityPolicyChanges",
        "trustRootChanges",
        "upToDateBeforeMerge",
        "humanMergeRequired"
      ],
      "properties": {
        "automerge": {"const": false},
        "scripts": {"const": false},
        "plugins": {"const": false},
        "shellExecution": {"const": false},
        "privilegedCi": {"const": false},
        "writeCapableChecks": {"const": false},
        "processAuthorityChanges": {"const": false},
        "workflowChanges": {"const": false},
        "releaseChanges": {"const": false},
        "deploymentChanges": {"const": false},
        "securityPolicyChanges": {"const": false},
        "trustRootChanges": {"const": false},
        "upToDateBeforeMerge": {"const": true},
        "humanMergeRequired": {"const": true}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "enabled",
        "targetBranch",
        "branchPrefix",
        "completionCheck",
        "allowedAutomationOwners",
        "allowedProposalKinds",
        "requiredControls"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "engineering-process-automation-proposal-policy"},
        "enabled": {"const": true},
        "targetBranch": {"$ref": "#/$defs/ref"},
        "branchPrefix": {
          "type": "string",
          "pattern": "^automation/[a-z0-9]+(?:-[a-z0-9]+)*/$",
          "maxLength": 128
        },
        "completionCheck": {"const": "lifecycle-completion"},
        "allowedAutomationOwners": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/name"}
        },
        "allowedProposalKinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"const": "dependency-update"}
        },
        "requiredControls": {"$ref": "#/$defs/controls"}
      }
    }
  }
}
