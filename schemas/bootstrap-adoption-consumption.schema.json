{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/bootstrap-adoption-consumption.schema.json",
  "$comment": "This schema and contract validate the complete serialized shape. Terminal consumption additionally relates the protected base/head/merge, validation artifact, workflow run, and App-owned check identities.",
  "title": "Terminal one-time bootstrap adoption consumption",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "project", "repository", "policySha256", "intentSha256", "authorizationSha256", "baseCheckpoint", "headCheckpoint", "headTree", "mergeCheckpoint", "checkContext", "validationArtifact", "validationService", "consumedAt"],
  "properties": {
    "schemaVersion": {"const": 1}, "kind": {"const": "engineering-process-bootstrap-adoption-consumption"},
    "project": {"$ref": "#/$defs/project"}, "repository": {"$ref": "#/$defs/repository"},
    "policySha256": {"$ref": "#/$defs/digest"}, "intentSha256": {"$ref": "#/$defs/digest"}, "authorizationSha256": {"$ref": "#/$defs/digest"},
    "baseCheckpoint": {"$ref": "#/$defs/gitOid"}, "headCheckpoint": {"$ref": "#/$defs/gitOid"}, "headTree": {"$ref": "#/$defs/gitOid"}, "mergeCheckpoint": {"$ref": "#/$defs/gitOid"},
    "checkContext": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$"},
    "validationArtifact": {"$ref": "#/$defs/serviceArtifact"},
    "validationService": {"$ref": "#/$defs/validationService"},
    "consumedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "project": {"type": "string", "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"}, "repository": {"type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}, "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!\\s)(?!.*\\s$)(?!/)(?!\\./)(?!.*\\/\\.\\/)(?!.*\\/\\.$)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\/$).+$"},
    "serviceArtifact": {"type": "object", "additionalProperties": false, "required": ["artifactId", "name", "digest", "runId", "runAttempt", "runUrl"], "properties": {"artifactId": {"type": "string", "pattern": "^[1-9][0-9]{0,63}$"}, "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$"}, "digest": {"$ref": "#/$defs/digest"}, "runId": {"type": "string", "pattern": "^[1-9][0-9]{0,63}$"}, "runAttempt": {"type": "integer", "minimum": 1, "maximum": 1000}, "runUrl": {"type": "string", "format": "uri", "pattern": "^https://\\S+$", "maxLength": 2048}}},
    "validationService": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "repository", "workflowPath", "workflowSha", "runId", "runAttempt", "runUrl", "event", "headSha", "runStatus", "runConclusion", "checkContext", "checkAppId", "checkRunId", "checkHeadSha", "checkConclusion"], "properties": {"schemaVersion": {"const": 1}, "kind": {"const": "engineering-process-transition-consumption-service"}, "repository": {"$ref": "#/$defs/repository"}, "workflowPath": {"$ref": "#/$defs/path"}, "workflowSha": {"$ref": "#/$defs/gitOid"}, "runId": {"type": "string", "pattern": "^[1-9][0-9]{0,63}$"}, "runAttempt": {"type": "integer", "minimum": 1, "maximum": 1000}, "runUrl": {"type": "string", "format": "uri", "pattern": "^https://\\S+$", "maxLength": 2048}, "event": {"const": "workflow_dispatch"}, "headSha": {"$ref": "#/$defs/gitOid"}, "runStatus": {"enum": ["in_progress", "completed"]}, "runConclusion": {"enum": [null, "success"]}, "checkContext": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$"}, "checkAppId": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}, "checkRunId": {"type": "string", "pattern": "^[1-9][0-9]{0,63}$"}, "checkHeadSha": {"$ref": "#/$defs/gitOid"}, "checkConclusion": {"const": "success"}}}
  }
}
