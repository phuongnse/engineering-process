{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/bootstrap-adoption-intent.schema.json",
  "title": "One-time producer bootstrap adoption intent",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "project", "repository", "changeId", "sourceAuthority", "targetRelease", "candidate", "policySha256", "ownerResolutionSha256", "expiresAt"],
  "properties": {
    "schemaVersion": {"const": 1}, "kind": {"const": "engineering-process-bootstrap-adoption-intent"},
    "project": {"$ref": "#/$defs/project"}, "repository": {"$ref": "#/$defs/repository"}, "changeId": {"$ref": "#/$defs/id"},
    "sourceAuthority": {"$ref": "#/$defs/authority"},
    "targetRelease": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "tag", "commit", "processDigest", "releaseContractSha256", "distributionAttestationSha256", "artifacts"],
      "properties": {"version": {"$ref": "#/$defs/version"}, "tag": {"$ref": "#/$defs/tag"}, "commit": {"$ref": "#/$defs/gitOid"}, "processDigest": {"$ref": "#/$defs/digest"}, "releaseContractSha256": {"$ref": "#/$defs/digest"}, "distributionAttestationSha256": {"$ref": "#/$defs/digest"}, "artifacts": {"type": "array", "minItems": 2, "maxItems": 16, "items": {"$ref": "#/$defs/artifact"}}}
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["requirementsInputSha256", "requirementsLockSha256", "projectManifestSha256", "projectMigrationSha256", "actionPinsSha256", "actionPins", "selectedSkills", "expectedChangedPaths"],
      "properties": {"requirementsInputSha256": {"$ref": "#/$defs/digest"}, "requirementsLockSha256": {"$ref": "#/$defs/digest"}, "projectManifestSha256": {"$ref": "#/$defs/digest"}, "projectMigrationSha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "actionPinsSha256": {"$ref": "#/$defs/digest"}, "actionPins": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/actionPin"}}, "selectedSkills": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "expectedChangedPaths": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}}
    },
    "policySha256": {"$ref": "#/$defs/digest"}, "ownerResolutionSha256": {"$ref": "#/$defs/digest"}, "expiresAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "maxLength": 64, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"}, "project": {"type": "string", "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"},
    "repository": {"type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}, "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"}, "tag": {"type": "string", "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"}, "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\/$).+$"},
    "authority": {"type": "object", "additionalProperties": false, "required": ["version", "digest"], "properties": {"version": {"$ref": "#/$defs/version"}, "digest": {"$ref": "#/$defs/digest"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["name", "sha256", "sizeBytes"], "properties": {"name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 200}, "sha256": {"$ref": "#/$defs/digest"}, "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 1000000000}}},
    "actionPin": {"type": "object", "additionalProperties": false, "required": ["path", "repository", "previousCommit", "targetCommit", "previousReleaseTag", "targetReleaseTag"], "properties": {"path": {"$ref": "#/$defs/path"}, "repository": {"$ref": "#/$defs/repository"}, "previousCommit": {"$ref": "#/$defs/gitOid"}, "targetCommit": {"$ref": "#/$defs/gitOid"}, "previousReleaseTag": {"$ref": "#/$defs/tag"}, "targetReleaseTag": {"$ref": "#/$defs/tag"}}}
  }
}
