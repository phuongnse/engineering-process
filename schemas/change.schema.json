{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/change.schema.json",
  "title": "Engineering change specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "summary",
    "source",
    "comparisonBase",
    "specification",
    "risk",
    "affectedProjects",
    "acceptanceCriteria",
    "requiredProfiles",
    "signOff"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"enum": [2, 3, 4]},
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "source": {"type": "string", "minLength": 1, "maxLength": 1000},
    "comparisonBase": {"type": "string", "minLength": 1, "maxLength": 256},
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "rationale"],
      "properties": {
        "kind": {"enum": ["project", "change-contract"]},
        "reference": {"type": "string", "minLength": 1, "maxLength": 1000},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "risk": {"enum": ["low", "medium", "high"]},
    "affectedProjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome"],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          },
          "outcome": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "requiredProfiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
      }
    },
    "requiredEvidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "assessments"],
      "properties": {
        "standard": {"const": "production-v1"},
        "assessments": {
          "type": "array",
          "minItems": 10,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/qualityAssessment"},
          "allOf": [
            {"contains": {"properties": {"dimension": {"const": "compatibility"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"dimension": {"const": "correctness"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"dimension": {"const": "maintainability"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"dimension": {"const": "observability"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"dimension": {"const": "operability"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"dimension": {"const": "performance"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"dimension": {"const": "privacy"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"dimension": {"const": "reliability"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"dimension": {"const": "security"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"dimension": {"const": "supply-chain"}}, "required": ["dimension"]}, "minContains": 1, "maxContains": 1}
          ]
        }
      }
    },
    "reviewBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "trustBoundaries", "faultRows", "outOfBoundary"],
      "properties": {
        "mode": {"const": "finite-fault-model"},
        "outOfBoundary": {"const": "owner-decision-and-supersede"},
        "trustBoundaries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "owner", "statement", "criterionIds"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "owner": {"type": "string", "minLength": 1, "maxLength": 256},
              "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
              "criterionIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/id"}
              }
            }
          }
        },
        "faultRows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "trustBoundaryId", "criterionIds", "trigger", "injectionBoundary", "expectedOutcome", "proof", "stopCondition"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "trustBoundaryId": {"$ref": "#/$defs/id"},
              "criterionIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/id"}
              },
              "trigger": {"type": "string", "minLength": 1, "maxLength": 2000},
              "injectionBoundary": {"type": "string", "minLength": 1, "maxLength": 2000},
              "expectedOutcome": {"type": "string", "minLength": 1, "maxLength": 2000},
              "stopCondition": {"type": "string", "minLength": 1, "maxLength": 2000},
              "proof": {
                "type": "object",
                "additionalProperties": false,
                "required": ["profiles", "evidenceRequirementIds", "assertion"],
                "properties": {
                  "profiles": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "uniqueItems": true,
                    "items": {"$ref": "#/$defs/id"}
                  },
                  "evidenceRequirementIds": {
                    "type": "array",
                    "maxItems": 64,
                    "uniqueItems": true,
                    "items": {"$ref": "#/$defs/id"}
                  },
                  "assertion": {"type": "string", "minLength": 1, "maxLength": 2000}
                }
              }
            }
          }
        }
      }
    },
    "signOff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "evidence"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["not-required", "pending", "approved"]},
        "evidence": {"type": ["string", "null"], "maxLength": 1000}
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "qualityAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "status", "rationale", "criteria"],
      "properties": {
        "dimension": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:compatibility|correctness|maintainability|observability|operability|performance|privacy|reliability|security|supply-chain|project-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)$"
        },
        "status": {"enum": ["applicable", "not-applicable"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 1000},
        "criteria": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "applicable"}}, "required": ["status"]},
          "then": {"properties": {"criteria": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "not-applicable"}}, "required": ["status"]},
          "then": {"properties": {"criteria": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"dimension": {"const": "correctness"}}, "required": ["dimension"]},
          "then": {"properties": {"status": {"const": "applicable"}}}
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 2}}, "required": ["schemaVersion"]},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["quality"]},
            {"required": ["requiredEvidence"]},
            {"required": ["reviewBoundary"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"schemaVersion": {"const": 3}}, "required": ["schemaVersion"]},
      "then": {
        "required": ["quality"],
        "not": {"required": ["reviewBoundary"]},
        "properties": {
          "affectedProjects": {"maxItems": 64},
          "acceptanceCriteria": {"maxItems": 256},
          "requiredProfiles": {"maxItems": 64}
        }
      }
    },
    {
      "if": {"properties": {"schemaVersion": {"const": 4}}, "required": ["schemaVersion"]},
      "then": {
        "required": ["quality", "reviewBoundary"],
        "properties": {
          "affectedProjects": {"maxItems": 64},
          "acceptanceCriteria": {"maxItems": 256},
          "requiredProfiles": {"maxItems": 64}
        }
      }
    }
  ]
}
