{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/change.schema.json",
  "title": "Accepted engineering change",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "summary", "source", "comparisonBase", "risk", "affectedProjects", "acceptanceCriteria", "requiredProfiles"],
  "properties": {
    "schemaVersion": {"const": 5},
    "id": {"$ref": "#/$defs/id"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "source": {"type": "string", "minLength": 1, "maxLength": 1000},
    "comparisonBase": {"type": "string", "minLength": 1, "maxLength": 256},
    "risk": {"enum": ["low", "medium", "high"]},
    "affectedProjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "outcome": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "requiredProfiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "consumerEvidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "incident"],
        "properties": {
          "repository": {"type": "string", "minLength": 1, "maxLength": 256},
          "incident": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    }
  }
}
