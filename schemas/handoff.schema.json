{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/handoff.schema.json",
  "title": "Sequential change handoff package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "changeId", "project", "authority", "candidate", "changedPaths", "state", "exportedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "change-handoff"},
    "changeId": {"$ref": "#/$defs/id"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "comparisonBaseCommit"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "comparisonBaseCommit": {"$ref": "#/$defs/commit"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distributionDigest", "runSchemaVersion", "handoffSchemaVersion"],
      "properties": {
        "distributionDigest": {"$ref": "#/$defs/digest"},
        "runSchemaVersion": {"const": 1},
        "handoffSchemaVersion": {"const": 1}
      }
    },
    "candidate": {"$ref": "#/$defs/checkpoint"},
    "changedPaths": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "state": {
      "type": "object",
      "required": ["schemaVersion", "changeId", "phase", "cycle", "comparisonBaseCommit", "contract", "plan", "verification", "reviewAssignment", "review", "reviewHistory", "controlPaths", "history"],
      "properties": {
        "schemaVersion": {"const": 1},
        "changeId": {"$ref": "#/$defs/id"},
        "phase": {"enum": ["specified", "planned", "implementing", "verified", "review-pending", "approved", "changes-requested", "blocked"]},
        "cycle": {"type": "integer", "minimum": 0},
        "comparisonBaseCommit": {"$ref": "#/$defs/commit"},
        "contract": {"type": "object"},
        "plan": {"type": ["object", "null"]},
        "verification": {"type": "object"},
        "reviewAssignment": {"type": ["object", "null"]},
        "review": {"type": ["object", "null"]},
        "reviewHistory": {"type": "array"},
        "implementations": {"type": "array"},
        "currentImplementation": {"type": ["object", "null"]},
        "requiredPlanSchemaVersion": {"const": 1},
        "requiredReviewSchemaVersion": {"const": 1},
        "controlPaths": {"type": "array"},
        "history": {"type": "array"}
      }
    },
    "exportedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "fingerprint", "fileCount", "byteCount"],
      "properties": {
        "head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
        "fingerprint": {"$ref": "#/$defs/digest"},
        "fileCount": {"type": "integer", "minimum": 0},
        "byteCount": {"type": "integer", "minimum": 0}
      }
    }
  }
}
