{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/improvement-catalog.schema.json",
  "title": "Producer-owned reusable process invariant catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "producer", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "engineering-process-improvement-catalog"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "repository"],
      "properties": {
        "project": {"$ref": "#/$defs/name"},
        "repository": {"$ref": "#/$defs/repository"}
      }
    },
    "entries": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reusableClass",
          "status",
          "publicSurfaces",
          "lastResolution",
          "activeChangeId"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "reusableClass": {"$ref": "#/$defs/reusableClass"},
          "status": {"enum": ["active", "resolved", "retired"]},
          "publicSurfaces": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          },
          "lastResolution": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["changeId", "version"],
                "properties": {
                  "changeId": {"$ref": "#/$defs/id"},
                  "version": {"$ref": "#/$defs/semver"}
                }
              },
              {"type": "null"}
            ]
          },
          "activeChangeId": {
            "anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "active"}}},
            "then": {"properties": {"activeChangeId": {"type": "string"}}}
          },
          {
            "if": {"properties": {"status": {"enum": ["resolved", "retired"]}}},
            "then": {
              "properties": {
                "lastResolution": {"type": "object"},
                "activeChangeId": {"type": "null"}
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"},
    "repository": {"type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "gitOid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "semver": {"type": "string", "maxLength": 64, "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "reusableClass": {"enum": ["deterministic-enforcement", "local-behavior", "obsolete-guidance", "portability-gap", "process-rule"]}
  }
}
