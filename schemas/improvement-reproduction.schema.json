{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/improvement-reproduction.schema.json",
  "title": "Released producer correction reproduction at a consumer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "completedAt",
    "signalSha256",
    "dispositionSha256",
    "resolutionSha256",
    "canonicalInvariantId",
    "consumer",
    "release",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "engineering-process-improvement-reproduction"},
    "completedAt": {"type": "string", "format": "date-time"},
    "signalSha256": {"$ref": "#/$defs/digest"},
    "dispositionSha256": {"$ref": "#/$defs/digest"},
    "resolutionSha256": {"$ref": "#/$defs/digest"},
    "canonicalInvariantId": {"$ref": "#/$defs/id"},
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "repository", "checkpoint", "workspaceFingerprint", "process"],
      "properties": {
        "project": {"$ref": "#/$defs/name"},
        "repository": {"$ref": "#/$defs/repository"},
        "checkpoint": {"$ref": "#/$defs/gitOid"},
        "workspaceFingerprint": {"$ref": "#/$defs/digest"},
        "process": {"$ref": "#/$defs/process"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version", "tag", "releaseName", "commit", "artifactSetSha256"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "version": {"$ref": "#/$defs/semver"},
        "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 65},
        "releaseName": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 65},
        "commit": {"$ref": "#/$defs/gitOid"},
        "artifactSetSha256": {"$ref": "#/$defs/digest"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "artifactSha256", "artifactBytes", "changeId", "cycle", "profiles", "reference"],
      "properties": {
        "kind": {"const": "lifecycle-receipt"},
        "status": {"const": "passed"},
        "artifactSha256": {"$ref": "#/$defs/digest"},
        "artifactBytes": {"type": "integer", "minimum": 1, "maximum": 8000000},
        "changeId": {"$ref": "#/$defs/id"},
        "cycle": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "reference": {"anyOf": [{"$ref": "#/$defs/httpsUri"}, {"type": "null"}]}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"},
    "repository": {"type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "gitOid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semver": {"type": "string", "maxLength": 64, "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "httpsUri": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {"version": {"$ref": "#/$defs/semver"}, "digest": {"$ref": "#/$defs/digest"}}
    }
  }
}
