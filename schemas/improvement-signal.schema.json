{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/improvement-signal.schema.json",
  "title": "Portable consumer process-improvement signal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "signalId",
    "createdAt",
    "source",
    "target",
    "trigger",
    "claim",
    "evidence",
    "controls"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "engineering-process-improvement-signal"},
    "signalId": {"$ref": "#/$defs/id"},
    "createdAt": {"type": "string", "format": "date-time"},
    "source": {"$ref": "#/$defs/source"},
    "target": {"$ref": "#/$defs/target"},
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status"],
      "properties": {
        "kind": {
          "enum": [
            "external-integration",
            "repeated-friction",
            "review-finding",
            "verification-failure"
          ]
        },
        "status": {
          "enum": ["blocked", "changes-requested", "failed", "timed-out"]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerBoundary",
        "reusableClass",
        "proposedInvariantId",
        "rationaleSha256",
        "affectedSurfaces"
      ],
      "properties": {
        "ownerBoundary": {"$ref": "#/$defs/ownerBoundary"},
        "reusableClass": {"$ref": "#/$defs/reusableClass"},
        "proposedInvariantId": {"$ref": "#/$defs/id"},
        "rationaleSha256": {"$ref": "#/$defs/digest"},
        "affectedSurfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifactSha256",
        "artifactBytes",
        "commandSha256",
        "diagnosticSha256",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "external-event",
            "review-report",
            "supplemental-verification",
            "verification-report"
          ]
        },
        "artifactSha256": {"$ref": "#/$defs/digest"},
        "artifactBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "commandSha256": {
          "anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "diagnosticSha256": {
          "anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "reference": {
          "anyOf": [{"$ref": "#/$defs/httpsUri"}, {"type": "null"}]
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawOutputIncluded",
        "environmentIncluded",
        "secretsIncluded",
        "grantsAuthority"
      ],
      "properties": {
        "rawOutputIncluded": {"const": false},
        "environmentIncluded": {"const": false},
        "secretsIncluded": {"const": false},
        "grantsAuthority": {"const": false}
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "repository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "httpsUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "version": {"$ref": "#/$defs/semver"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "repository",
        "checkpoint",
        "workspaceFingerprint",
        "process",
        "changeId",
        "cycle"
      ],
      "properties": {
        "project": {"$ref": "#/$defs/name"},
        "repository": {"$ref": "#/$defs/repository"},
        "checkpoint": {"$ref": "#/$defs/gitOid"},
        "workspaceFingerprint": {"$ref": "#/$defs/digest"},
        "process": {"$ref": "#/$defs/process"},
        "changeId": {
          "anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
        },
        "cycle": {
          "anyOf": [
            {"type": "integer", "minimum": 1, "maximum": 1000000},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"changeId": {"type": "null"}}},
          "then": {"properties": {"cycle": {"type": "null"}}}
        },
        {
          "if": {"properties": {"changeId": {"type": "string"}}},
          "then": {"properties": {"cycle": {"type": "integer"}}}
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "repository"],
      "properties": {
        "project": {"$ref": "#/$defs/name"},
        "repository": {"$ref": "#/$defs/repository"}
      }
    },
    "ownerBoundary": {
      "enum": [
        "missing-product-or-authorization-input",
        "operations-or-external",
        "project-local",
        "shared-process"
      ]
    },
    "reusableClass": {
      "enum": [
        "deterministic-enforcement",
        "local-behavior",
        "obsolete-guidance",
        "portability-gap",
        "process-rule"
      ]
    }
  }
}
