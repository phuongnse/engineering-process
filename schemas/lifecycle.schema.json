{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/lifecycle.schema.json",
  "title": "Engineering change lifecycle state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "changeId",
    "project",
    "phase",
    "cycle",
    "revision",
    "comparisonBase",
    "contract",
    "plan",
    "implementationActors",
    "verification",
    "pendingFindings",
    "reviewAssignment",
    "review",
    "completion",
    "history"
  ],
  "properties": {
    "schemaVersion": {"enum": [2, 3]},
    "changeId": {"type": "string"},
    "project": {"type": "string"},
    "phase": {
      "enum": [
        "specified",
        "planned",
        "implementing",
        "improvement-required",
        "improvement-pending",
        "verified",
        "review-pending",
        "changes-requested",
        "approved",
        "completed"
      ]
    },
    "cycle": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 1},
    "comparisonBase": {"type": "string"},
    "contract": {"$ref": "#/$defs/artifact"},
    "plan": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
    "planDecision": {
      "anyOf": [{"$ref": "#/$defs/planDecision"}, {"type": "null"}]
    },
    "implementationActors": {"type": "array", "items": {"$ref": "#/$defs/actor"}},
    "verification": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "remoteVerification": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/remoteVerification"}
      ]
    },
    "authorityTransition": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["request", "candidateEvidence"],
          "properties": {
            "request": {"$ref": "#/$defs/artifact"},
            "candidateEvidence": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
          }
        }
      ]
    },
    "pendingFindings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "reviewAssignment": {"type": ["object", "null"]},
    "review": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
    "completion": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
    "history": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "improvements": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/improvementCase"}
    },
    "reviewLoop": {
      "anyOf": [{"$ref": "#/$defs/reviewLoop"}, {"type": "null"}]
    }
  },
  "$defs": {
    "reviewLoop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "threshold", "window", "escalations"],
      "properties": {
        "schemaVersion": {"const": 1},
        "threshold": {"const": 3},
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "startedAtCycle", "reviewCycles"],
          "properties": {
            "number": {"type": "integer", "minimum": 1},
            "startedAtCycle": {"type": "integer", "minimum": 1},
            "reviewCycles": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            }
          }
        },
        "escalations": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/reviewLoopEscalation"}
        }
      }
    },
    "reviewLoopEscalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "triggerCycle", "reviewCycles", "findingIds", "decision"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$", "maxLength": 64},
        "kind": {"enum": ["cycle-limit", "contract-gap"]},
        "status": {"enum": ["decision-required", "resolved", "superseded"]},
        "triggerCycle": {"type": "integer", "minimum": 1},
        "reviewCycles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "findingIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$", "maxLength": 64}
        },
        "decision": {
          "anyOf": [{"$ref": "#/$defs/reviewLoopDecision"}, {"type": "null"}]
        }
      }
    },
    "reviewLoopDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planDecisionAssignment", "planDecisionReview", "recommendation", "recommendationAssignment", "recommendationReview", "resolution", "selectedOptionId", "lifecycleEffect"],
      "properties": {
        "planDecisionAssignment": {"$ref": "#/$defs/artifact"},
        "planDecisionReview": {"$ref": "#/$defs/artifact"},
        "recommendation": {"$ref": "#/$defs/artifact"},
        "recommendationAssignment": {"$ref": "#/$defs/artifact"},
        "recommendationReview": {"$ref": "#/$defs/artifact"},
        "resolution": {"$ref": "#/$defs/artifact"},
        "selectedOptionId": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$", "maxLength": 64},
        "lifecycleEffect": {"enum": ["resume-correction-window", "supersede-change"]}
      }
    },
    "planDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "authorized",
        "assignment",
        "review",
        "recommendation",
        "recommendationAssignment",
        "recommendationReview",
        "resolution"
      ],
      "properties": {
        "kind": {"enum": ["authored", "process-generated"]},
        "authorized": {"type": "boolean"},
        "assignment": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "review": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "recommendation": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "recommendationAssignment": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "recommendationReview": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "resolution": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
      }
    },
    "actor": {
      "type": "object",
      "required": ["actorId", "contextId", "kind"],
      "properties": {
        "actorId": {"type": "string"},
        "contextId": {"type": "string"},
        "kind": {"enum": ["agent", "human"]}
      }
    },
    "artifact": {
      "type": "object",
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["profile", "path", "digest", "checkpoint", "workspaceFingerprint"],
      "properties": {
        "profile": {"type": "string"},
        "path": {"type": "string"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "checkpoint": {"type": "string"},
        "workspaceFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "remoteVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredEvidence", "request", "evidence"],
      "properties": {
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "request": {
          "anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]
        },
        "evidence": {
          "anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "path",
        "line",
        "summary",
        "evidence",
        "status",
        "resolutionEvidence"
      ],
      "properties": {
        "id": {"type": "string"},
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "path": {"type": "string"},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "summary": {"type": "string"},
        "evidence": {"type": "string"},
        "status": {"enum": ["open", "deferred"]},
        "resolutionEvidence": {"type": ["string", "null"], "maxLength": 4000}
        ,"boundaryStatus": {"enum": ["covered", "contract-gap"]}
        ,"trustBoundaryId": {"type": ["string", "null"], "maxLength": 64}
        ,"faultRowId": {"type": ["string", "null"], "maxLength": 64}
        ,"criterionIds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "maxLength": 64}
        }
      },
      "dependentRequired": {
        "boundaryStatus": ["trustBoundaryId", "faultRowId", "criterionIds"],
        "trustBoundaryId": ["boundaryStatus", "faultRowId", "criterionIds"],
        "faultRowId": ["boundaryStatus", "trustBoundaryId", "criterionIds"],
        "criterionIds": ["boundaryStatus", "trustBoundaryId", "faultRowId"]
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "open"}}},
          "then": {"properties": {"resolutionEvidence": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"const": "deferred"}}},
          "then": {
            "properties": {
              "resolutionEvidence": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"boundaryStatus": {"const": "covered"}},
            "required": ["boundaryStatus"]
          },
          "then": {
            "properties": {
              "trustBoundaryId": {"type": "string"},
              "faultRowId": {"type": "string"},
              "criterionIds": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"boundaryStatus": {"const": "contract-gap"}},
            "required": ["boundaryStatus"]
          },
          "then": {
            "properties": {
              "status": {"const": "open"},
              "trustBoundaryId": {"type": "null"},
              "faultRowId": {"type": "null"},
              "criterionIds": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "improvementCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "trigger",
        "phase",
        "sourceCycle",
        "findingId",
        "evidence",
        "classification",
        "signal",
        "catalog",
        "disposition",
        "resolution",
        "reproduction"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$", "maxLength": 64},
        "role": {"enum": ["consumer", "local", "producer"]},
        "trigger": {"enum": ["external-integration", "repeated-friction", "review-finding", "verification-failure"]},
        "phase": {
          "enum": [
            "classification-required",
            "input-required",
            "local-resolution-required",
            "producer-change",
            "producer-completed",
            "producer-disposition-required",
            "producer-resolution-required",
            "consumer-reproduction-required",
            "closed"
          ]
        },
        "sourceCycle": {"type": "integer", "minimum": 1},
        "findingId": {"type": ["string", "null"]},
        "evidence": {"$ref": "#/$defs/artifact"},
        "classification": {"type": ["object", "null"]},
        "signal": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "catalog": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "disposition": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "resolution": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "reproduction": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 2}}, "required": ["schemaVersion"]},
      "then": {"not": {"required": ["authorityTransition"]}}
    },
    {
      "if": {"properties": {"schemaVersion": {"const": 3}}, "required": ["schemaVersion"]},
      "then": {
        "required": ["authorityTransition"],
        "properties": {
          "authorityTransition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["request", "candidateEvidence"],
            "properties": {
              "request": {"$ref": "#/$defs/artifact"},
              "candidateEvidence": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
            }
          }
        }
      }
    }
  ]
}
