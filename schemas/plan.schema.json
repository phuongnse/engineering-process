{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/plan.schema.json",
  "title": "Engineering implementation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeId", "contractDigest", "approach", "workItems", "risks"],
  "properties": {
    "schemaVersion": {"enum": [4, 5]},
    "changeId": {"$ref": "#/$defs/id"},
    "contractDigest": {"$ref": "#/$defs/digest"},
    "approach": {"type": "string", "minLength": 1, "maxLength": 4000},
    "workItems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "affectedPaths"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "outcome": {"type": "string", "minLength": 1, "maxLength": 1000},
          "affectedPaths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk", "mitigation"],
        "properties": {
          "risk": {"type": "string", "minLength": 1, "maxLength": 1000},
          "mitigation": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "productionEngineering": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/invariantAssessment"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 5}}, "required": ["schemaVersion"]},
      "then": {"required": ["productionEngineering"]},
      "else": {"not": {"required": ["productionEngineering"]}}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "invariantAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "applicability", "rationale", "evidenceWorkItems"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "applicability": {"enum": ["applicable", "not-applicable"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
        "evidenceWorkItems": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"applicability": {"const": "applicable"}},
            "required": ["applicability"]
          },
          "then": {"properties": {"evidenceWorkItems": {"minItems": 1}}},
          "else": {"properties": {"evidenceWorkItems": {"maxItems": 0}}}
        }
      ]
    }
  }
}
