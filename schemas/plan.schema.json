{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/plan.schema.json",
  "title": "Engineering implementation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeId", "contractDigest", "approach", "workItems", "risks"],
  "properties": {
    "schemaVersion": {"const": 4},
    "changeId": {"$ref": "#/$defs/id"},
    "contractDigest": {"$ref": "#/$defs/digest"},
    "approach": {"type": "string", "minLength": 1, "maxLength": 4000},
    "workItems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "affectedPaths"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "outcome": {"type": "string", "minLength": 1, "maxLength": 1000},
          "affectedPaths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk", "mitigation"],
        "properties": {
          "risk": {"type": "string", "minLength": 1, "maxLength": 1000},
          "mitigation": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
