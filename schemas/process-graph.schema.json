{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/process-graph.schema.json",
  "title": "Engineering process lifecycle and skill graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entrySkill", "states"],
  "properties": {
    "schemaVersion": {"const": 1},
    "entrySkill": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"},
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ownerSkill", "actor", "commands", "transitions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"},
          "ownerSkill": {"type": ["string", "null"], "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"},
          "actor": {"enum": ["automation", "human"]},
          "commands": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z-]*(?: [a-z][a-z-]*)*$"}
          },
          "transitions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["result", "nextState", "nextSkill"],
              "properties": {
                "result": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"},
                "nextState": {"type": ["string", "null"], "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"},
                "nextSkill": {"type": ["string", "null"], "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"}
              }
            }
          }
        }
      }
    }
  }
}
