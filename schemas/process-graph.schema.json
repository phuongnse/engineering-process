{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/process-graph.schema.json",
  "title": "Skill and lifecycle routing graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entrySkill", "states", "specializations"],
  "properties": {
    "schemaVersion": {"const": 2},
    "entrySkill": {"$ref": "#/$defs/skill"},
    "specializations": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/skill"}
    },
    "states": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ownerSkill", "commands", "transitions"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "ownerSkill": {"$ref": "#/$defs/skill"},
          "commands": {
            "type": "array",
            "maxItems": 4,
            "items": {"type": "string", "minLength": 1, "maxLength": 100}
          },
          "transitions": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["result", "nextState", "nextSkill"],
              "properties": {
                "result": {"$ref": "#/$defs/id"},
                "nextState": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
                "nextSkill": {"oneOf": [{"$ref": "#/$defs/skill"}, {"type": "null"}]}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "skill": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
