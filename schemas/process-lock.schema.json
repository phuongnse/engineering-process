{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/process-lock.schema.json",
  "title": "Adopted process lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "process", "skills"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1, "maxLength": 1000},
    "schemaVersion": {"enum": [1, 2]},
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "package": {"const": "engineering-process"},
        "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "requirementsDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "managedFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\/$).+$"
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 1}}, "required": ["schemaVersion"]},
      "then": {
        "not": {"anyOf": [{"required": ["requirementsDigest"]}, {"required": ["managedFiles"]}]},
        "properties": {"process": {"not": {"required": ["package"]}}}
      }
    },
    {
      "if": {"properties": {"schemaVersion": {"const": 2}}, "required": ["schemaVersion"]},
      "then": {
        "required": ["requirementsDigest", "managedFiles"],
        "properties": {"process": {"required": ["package"]}}
      }
    }
  ]
}
