{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/production-engineering.schema.json",
  "title": "Production engineering invariant floor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "invariants"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"const": "production-engineering-floor"},
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/invariant"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "text": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "trigger", "requiredStructure", "prohibitedFailure", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/text"},
        "trigger": {"$ref": "#/$defs/text"},
        "requiredStructure": {"$ref": "#/$defs/text"},
        "prohibitedFailure": {"$ref": "#/$defs/text"},
        "evidence": {"$ref": "#/$defs/text"}
      }
    }
  }
}
