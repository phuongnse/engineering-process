{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/project-legacy.schema.json",
  "title": "Pre-1.0 engineering process project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "lifecycle", "profiles"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "enum": [1, 2, 3, 4]
    },
    "project": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredProfiles"],
      "properties": {
        "requiredProfiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          }
        },
        "qualityExtensions": {
          "type": "array",
          "maxItems": 246,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^project-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          }
        },
        "planDecision": {
          "$ref": "#/$defs/planDecision"
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/check"
        }
      }
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "impact": {
      "$ref": "#/$defs/impact"
    },
    "remoteVerification": {
      "$ref": "#/$defs/remoteVerification"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 1}}, "required": ["schemaVersion"]},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["environment"]},
            {"required": ["impact"]},
            {"required": ["remoteVerification"]},
            {"properties": {"lifecycle": {"required": ["planDecision"]}}}
          ]
        },
        "properties": {
          "lifecycle": {
            "not": {
              "anyOf": [
                {"required": ["qualityExtensions"]},
                {"required": ["planDecision"]}
              ]
            }
          },
          "profiles": {
            "additionalProperties": {
              "items": {"not": {"required": ["components"]}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schemaVersion": {"const": 2}}, "required": ["schemaVersion"]},
      "then": {
        "required": ["environment"],
        "not": {
          "anyOf": [
            {"required": ["impact"]},
            {"required": ["remoteVerification"]}
          ]
        },
        "properties": {
          "lifecycle": {
            "not": {
              "anyOf": [
                {"required": ["qualityExtensions"]},
                {"required": ["planDecision"]}
              ]
            }
          },
          "profiles": {
            "additionalProperties": {
              "items": {"not": {"required": ["components"]}}
            }
          },
          "environment": {
            "not": {"required": ["foregroundOnly"]},
            "properties": {
              "managedTools": {
                "items": {
                  "properties": {
                    "artifacts": {
                      "items": {
                        "properties": {
                          "commands": {
                            "additionalProperties": {"type": "string"}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schemaVersion": {"enum": [3, 4]}}, "required": ["schemaVersion"]},
      "then": {
        "required": ["environment"],
        "properties": {
          "environment": {
            "required": ["foregroundOnly"],
            "properties": {
              "managedTools": {
                "items": {
                  "properties": {
                    "artifacts": {
                      "items": {
                        "allOf": [
                          {
                            "properties": {
                              "commands": {
                                "additionalProperties": {
                                  "oneOf": [
                                    {
                                      "type": "string",
                                      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\/$).+$"
                                    },
                                    {
                                      "type": "object",
                                      "properties": {
                                        "executable": {
                                          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\/$).+$"
                                        },
                                        "script": {
                                          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\/$).+$"
                                        }
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          },
                          {
                            "if": {
                              "properties": {"platform": {"pattern": "^windows-"}},
                              "required": ["platform"]
                            },
                            "then": {
                              "properties": {
                                "commands": {
                                  "additionalProperties": {
                                    "oneOf": [
                                      {"type": "string", "pattern": "\\.[eE][xX][eE]$"},
                                      {
                                        "type": "object",
                                        "properties": {
                                          "executable": {"pattern": "\\.[eE][xX][eE]$"}
                                        }
                                      }
                                    ]
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schemaVersion": {"const": 4}}, "required": ["schemaVersion"]},
      "then": {
        "properties": {
          "lifecycle": {
            "properties": {
              "requiredProfiles": {"maxItems": 64}
            }
          },
          "profiles": {
            "maxProperties": 64,
            "additionalProperties": {
              "maxItems": 256,
              "items": {
                "properties": {
                  "run": {"maxItems": 256},
                  "components": {"maxItems": 256}
                }
              }
            }
          },
          "environment": {
            "properties": {
              "requirements": {
                "items": {
                  "properties": {
                    "probe": {
                      "properties": {"run": {"maxItems": 256}}
                    }
                  }
                }
              },
              "setupActions": {
                "items": {
                  "if": {
                    "properties": {"kind": {"const": "command"}},
                    "required": ["kind"]
                  },
                  "then": {
                    "properties": {"run": {"maxItems": 256}}
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "planDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "materialCategories"],
      "properties": {
        "mode": {"const": "provenance-gated-authored-review"},
        "materialCategories": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "prefixItems": [
            {"const": "architecture"},
            {"const": "authority"},
            {"const": "compatibility"},
            {"const": "external-mutation"},
            {"const": "lifecycle-order"},
            {"const": "owner"},
            {"const": "rollout"},
            {"const": "scope"},
            {"const": "trust-boundary"}
          ],
          "items": false
        }
      }
    },
    "remoteVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements"],
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/remoteVerificationRequirement"}
        }
      }
    },
    "remoteVerificationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profiles", "execution", "selectors"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "repository", "workflow", "workflowRef"],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
            },
            "repository": {
              "type": "string",
              "minLength": 3,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "workflow": {"type": "string", "minLength": 1, "maxLength": 256},
            "workflowRef": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/remoteVerificationSelector"}
        }
      }
    },
    "remoteVerificationSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runnerOs", "implementation", "pythonMinor"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "runnerOs": {"type": "string", "minLength": 1, "maxLength": 64},
        "runnerArch": {"type": "string", "minLength": 1, "maxLength": 64},
        "implementation": {"type": "string", "minLength": 1, "maxLength": 64},
        "pythonMinor": {
          "type": "string",
          "pattern": "^3\\.(?:11|12|13|14)$"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "run", "timeoutSeconds"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "run": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseRefs", "components", "unmatchedPaths"],
      "properties": {
        "baseRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^(?!-)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9](?:[A-Za-z0-9._/-]*[A-Za-z0-9_-])?$"
          }
        },
        "unmatchedPaths": {
          "const": "all-scoped-checks"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/impactComponent"
          }
        }
      }
    },
    "impactComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paths", "affects"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\/$)(?:(?:\\*\\*|(?:(?!\\*\\*)[^/])+)/)*(?:\\*\\*|(?:(?!\\*\\*)[^/])+)$"
          }
        },
        "affects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultProfile", "profiles", "requirements", "managedTools", "setupActions"],
      "properties": {
        "defaultProfile": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "foregroundOnly": {
          "const": true
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
            }
          }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/environmentRequirement"
          }
        },
        "managedTools": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/managedTool"
          }
        },
        "setupActions": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/setupAction"
          }
        }
      }
    },
    "managedTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "artifacts"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[0-9A-Za-z](?:[0-9A-Za-z._+-]*[0-9A-Za-z])?$"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/managedToolArtifact"
          }
        }
      }
    },
    "managedToolArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "url",
        "checksum",
        "archiveFormat",
        "stripComponents",
        "maxDownloadBytes",
        "maxExtractedBytes",
        "maxFiles",
        "commands"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "pattern": "^(?:linux-(?:glibc|musl)-(?:x64|arm64)|macos-(?:x64|arm64)|windows-(?:x64|arm64))$"
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://"
        },
        "checksum": {
          "type": "string",
          "pattern": "^(?:sha256:[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
        },
        "archiveFormat": {
          "enum": ["file", "tar.gz", "zip"]
        },
        "stripComponents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "maxDownloadBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "maxExtractedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "maxFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "commands": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["executable", "script"],
                "properties": {
                  "executable": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "script": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                }
              }
            ]
          }
        }
      }
    },
    "environmentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "probe", "remediation"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "probe": {
          "$ref": "#/$defs/environmentCommand"
        },
        "remediation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "setupAction": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        }
      }
    },
    "environmentCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "timeoutSeconds", "readOnly"],
      "properties": {
        "run": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "readOnly": {
          "const": true
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "outputStream": {
          "enum": ["combined", "stderr", "stdout"]
        },
        "outputRegex": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "setupAction": {
      "oneOf": [
        {"$ref": "#/$defs/commandSetupAction"},
        {"$ref": "#/$defs/managedToolSetupAction"}
      ]
    },
    "commandSetupAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "run", "timeoutSeconds", "mutations"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "kind": {
          "const": "command"
        },
        "run": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "host-configuration",
              "network",
              "project-files",
              "user-files"
            ]
          }
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          }
        }
      }
    },
    "managedToolSetupAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "tool", "timeoutSeconds"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "kind": {
          "const": "managed-tool"
        },
        "tool": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          }
        }
      }
    }
  }
}
