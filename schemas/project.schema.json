{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/project.schema.json",
  "title": "Engineering process project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "lifecycle", "profiles"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "enum": [1, 2, 3]
    },
    "project": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredProfiles"],
      "properties": {
        "requiredProfiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/check"
        }
      }
    },
    "environment": {
      "$ref": "#/$defs/environment"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 1}}, "required": ["schemaVersion"]},
      "then": {"not": {"required": ["environment"]}}
    },
    {
      "if": {"properties": {"schemaVersion": {"const": 2}}, "required": ["schemaVersion"]},
      "then": {
        "required": ["environment"],
        "properties": {
          "environment": {
            "not": {"required": ["foregroundOnly"]},
            "properties": {
              "managedTools": {
                "items": {
                  "properties": {
                    "artifacts": {
                      "items": {
                        "properties": {
                          "commands": {
                            "additionalProperties": {"type": "string"}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schemaVersion": {"const": 3}}, "required": ["schemaVersion"]},
      "then": {
        "required": ["environment"],
        "properties": {
          "environment": {
            "required": ["foregroundOnly"],
            "properties": {
              "managedTools": {
                "items": {
                  "properties": {
                    "artifacts": {
                      "items": {
                        "allOf": [
                          {
                            "properties": {
                              "commands": {
                                "additionalProperties": {
                                  "oneOf": [
                                    {
                                      "type": "string",
                                      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\/$).+$"
                                    },
                                    {
                                      "type": "object",
                                      "properties": {
                                        "executable": {
                                          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\/$).+$"
                                        },
                                        "script": {
                                          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\/$).+$"
                                        }
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          },
                          {
                            "if": {
                              "properties": {"platform": {"pattern": "^windows-"}},
                              "required": ["platform"]
                            },
                            "then": {
                              "properties": {
                                "commands": {
                                  "additionalProperties": {
                                    "oneOf": [
                                      {"type": "string", "pattern": "\\.[eE][xX][eE]$"},
                                      {
                                        "type": "object",
                                        "properties": {
                                          "executable": {"pattern": "\\.[eE][xX][eE]$"}
                                        }
                                      }
                                    ]
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "run", "timeoutSeconds"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "run": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultProfile", "profiles", "requirements", "managedTools", "setupActions"],
      "properties": {
        "defaultProfile": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "foregroundOnly": {
          "const": true
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
            }
          }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/environmentRequirement"
          }
        },
        "managedTools": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/managedTool"
          }
        },
        "setupActions": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/setupAction"
          }
        }
      }
    },
    "managedTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "artifacts"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[0-9A-Za-z](?:[0-9A-Za-z._+-]*[0-9A-Za-z])?$"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/managedToolArtifact"
          }
        }
      }
    },
    "managedToolArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "url",
        "checksum",
        "archiveFormat",
        "stripComponents",
        "maxDownloadBytes",
        "maxExtractedBytes",
        "maxFiles",
        "commands"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "pattern": "^(?:linux-(?:glibc|musl)-(?:x64|arm64)|macos-(?:x64|arm64)|windows-(?:x64|arm64))$"
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://"
        },
        "checksum": {
          "type": "string",
          "pattern": "^(?:sha256:[0-9a-f]{64}|sha512:[0-9a-f]{128})$"
        },
        "archiveFormat": {
          "enum": ["file", "tar.gz", "zip"]
        },
        "stripComponents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "maxDownloadBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "maxExtractedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "maxFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "commands": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["executable", "script"],
                "properties": {
                  "executable": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "script": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                }
              }
            ]
          }
        }
      }
    },
    "environmentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "probe", "remediation"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "probe": {
          "$ref": "#/$defs/environmentCommand"
        },
        "remediation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "setupAction": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        }
      }
    },
    "environmentCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "timeoutSeconds", "readOnly"],
      "properties": {
        "run": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "readOnly": {
          "const": true
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "outputStream": {
          "enum": ["combined", "stderr", "stdout"]
        },
        "outputRegex": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "setupAction": {
      "oneOf": [
        {"$ref": "#/$defs/commandSetupAction"},
        {"$ref": "#/$defs/managedToolSetupAction"}
      ]
    },
    "commandSetupAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "run", "timeoutSeconds", "mutations"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "kind": {
          "const": "command"
        },
        "run": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "host-configuration",
              "network",
              "project-files",
              "user-files"
            ]
          }
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          }
        }
      }
    },
    "managedToolSetupAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "tool", "timeoutSeconds"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "kind": {
          "const": "managed-tool"
        },
        "tool": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          }
        }
      }
    }
  }
}
