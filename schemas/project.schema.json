{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/project.schema.json",
  "title": "Consumer project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "lifecycle", "profiles"],
  "properties": {
    "schemaVersion": {"const": 5},
    "project": {"$ref": "#/$defs/id"},
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredProfiles"],
      "properties": {
        "requiredProfiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "processChanges": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requireConsumerEvidence"],
          "properties": {
            "requireConsumerEvidence": {"type": "boolean"},
            "acceptedIssueUrlPrefix": {
              "type": "string",
              "minLength": 10,
              "maxLength": 512,
              "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[1-9][0-9]{0,4})?/(?:[A-Za-z0-9._~-]+/)+(?![\\s\\S])"
            }
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {"$ref": "#/$defs/check"}
      }
    },
    "setup": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/check"}
    },
    "readiness": {"$ref": "#/$defs/readiness"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "run", "timeoutSeconds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "run": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 14400},
        "maxOutputBytes": {"type": "integer", "minimum": 1024, "maximum": 1000000},
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "stage", "packs", "capabilities"],
      "properties": {
        "target": {"const": "production"},
        "stage": {"enum": ["building", "production"]},
        "packs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": {"enum": ["desktop-media", "library-cli", "operations"]},
              "version": {"type": "integer", "minimum": 1, "maximum": 1000}
            }
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "state"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "state": {"enum": ["enforced", "planned"]},
              "evidenceProfiles": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/id"}
              },
              "gap": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"}
            },
            "allOf": [
              {
                "if": {"properties": {"state": {"const": "enforced"}}},
                "then": {"required": ["evidenceProfiles"], "not": {"required": ["gap"]}}
              },
              {
                "if": {"properties": {"state": {"const": "planned"}}},
                "then": {"required": ["gap"], "not": {"required": ["evidenceProfiles"]}}
              }
            ]
          }
        }
      }
    }
  }
}
