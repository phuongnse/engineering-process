{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/project.schema.json",
  "title": "Consumer project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "lifecycle", "profiles"],
  "properties": {
    "schemaVersion": {"const": 5},
    "project": {"$ref": "#/$defs/id"},
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredProfiles"],
      "properties": {
        "requiredProfiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "processChanges": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requireConsumerEvidence"],
          "properties": {
            "requireConsumerEvidence": {"type": "boolean"}
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {"$ref": "#/$defs/check"}
      }
    },
    "setup": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "run", "timeoutSeconds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "run": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 14400},
        "maxOutputBytes": {"type": "integer", "minimum": 1024, "maximum": 1000000},
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      }
    }
  }
}
