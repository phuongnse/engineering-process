{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/recommendation-review-assignment.schema.json",
  "title": "Stateful independent recommendation review assignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "decisionId",
    "recommendationSha256",
    "coordinator",
    "reviewer",
    "independence",
    "contextReservationSha256"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "engineering-process-recommendation-review-assignment"},
    "decisionId": {"$ref": "#/$defs/id"},
    "recommendationSha256": {"$ref": "#/$defs/digest"},
    "coordinator": {"$ref": "#/$defs/actor"},
    "reviewer": {"$ref": "#/$defs/actor"},
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "attestedBy", "evidence"],
      "properties": {
        "method": {"enum": ["isolated-context", "separate-person"]},
        "attestedBy": {"type": "string", "minLength": 1, "maxLength": 256},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "contextReservationSha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "contextId", "kind"],
      "properties": {
        "actorId": {"type": "string", "minLength": 1, "maxLength": 256},
        "contextId": {"type": "string", "minLength": 1, "maxLength": 256},
        "kind": {"enum": ["agent", "human"]}
      }
    }
  }
}
