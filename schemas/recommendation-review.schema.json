{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/recommendation-review.schema.json",
  "title": "Independent adversarial recommendation review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "decisionId",
    "recommendationSha256",
    "assignmentSha256",
    "reviewer",
    "challengeAssessments",
    "invariantAssessments",
    "optionAssessments",
    "verdict",
    "findings"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "engineering-process-recommendation-review"},
    "decisionId": {"$ref": "#/$defs/id"},
    "recommendationSha256": {"$ref": "#/$defs/digest"},
    "assignmentSha256": {"$ref": "#/$defs/digest"},
    "reviewer": {"$ref": "#/$defs/actor"},
    "challengeAssessments": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/challengeAssessment"}
    },
    "invariantAssessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariantId", "status", "evidence"],
        "properties": {
          "invariantId": {"$ref": "#/$defs/id"},
          "status": {"enum": ["verified", "failed"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "optionAssessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["optionId", "status", "evidence"],
        "properties": {
          "optionId": {"$ref": "#/$defs/id"},
          "status": {"enum": ["verified", "failed"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "verdict": {"enum": ["approved", "changes-requested"]},
    "findings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "summary", "evidence", "status", "resolutionEvidence"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 4000},
          "status": {"enum": ["open", "resolved", "deferred", "false-positive"]},
          "resolutionEvidence": {"type": ["string", "null"], "maxLength": 4000}
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "contextId", "kind"],
      "properties": {
        "actorId": {"type": "string", "minLength": 1, "maxLength": 256},
        "contextId": {"type": "string", "minLength": 1, "maxLength": 256},
        "kind": {"enum": ["agent", "human"]}
      }
    },
    "challengeAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "status", "evidence"],
      "properties": {
        "category": {"enum": ["assumption-evidence", "invariant-trace", "option-classification", "terminal-ordering"]},
        "status": {"enum": ["verified", "failed"]},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  }
}
