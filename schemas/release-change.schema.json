{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/release-change.schema.json",
  "title": "Release change fragment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "type", "summary", "source", "details"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "type": {"enum": ["fix", "capability", "breaking"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "source": {"type": "string", "minLength": 1, "maxLength": 1000},
    "details": {"$ref": "#/$defs/details"}
  },
  "$defs": {
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "changes",
        "affectedPaths",
        "apply",
        "compatibility",
        "notes"
      ],
      "properties": {
        "problem": {"$ref": "#/$defs/text"},
        "changes": {"$ref": "#/$defs/text"},
        "affectedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/pathText"}
        },
        "apply": {"$ref": "#/$defs/text"},
        "compatibility": {"$ref": "#/$defs/text"},
        "notes": {"$ref": "#/$defs/text"}
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S",
      "not": {"pattern": "[\\r\\n\\v\\f\\u0085\\u2028\\u2029]"}
    },
    "pathText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S",
      "not": {"pattern": "[\\r\\n\\v\\f\\u0085\\u2028\\u2029]"}
    }
  }
}
