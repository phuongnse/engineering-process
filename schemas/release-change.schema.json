{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/release-change.schema.json",
  "title": "Release change fragment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "type", "summary", "source"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "type": {"enum": ["fix", "capability", "breaking"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "source": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}
