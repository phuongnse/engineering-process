{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/release.schema.json",
  "title": "Published release identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "previousVersion", "changes"],
  "properties": {
    "schemaVersion": {"const": 5},
    "version": {"$ref": "#/$defs/version"},
    "previousVersion": {"$ref": "#/$defs/version"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "summary", "source"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          },
          "type": {"enum": ["fix", "capability", "breaking"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
          "source": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    }
  }
}
