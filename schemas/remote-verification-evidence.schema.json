{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/remote-verification-evidence.schema.json",
  "title": "Remote verification service evidence set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "requestSha256", "capturedAt", "artifacts"],
  "properties": {
    "schemaVersion": {"enum": [1, 2]},
    "kind": {"const": "engineering-process-remote-verification-evidence"},
    "requestSha256": {"$ref": "#/$defs/sha256"},
    "capturedAt": {"type": "string", "format": "date-time"},
    "authorityTransition": {"$ref": "#/$defs/authorityTransition"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1000},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "authorityTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "candidateEvidence"],
      "properties": {
        "request": {"$ref": "#/$defs/reference"},
        "candidateEvidence": {"$ref": "#/$defs/reference"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "selectorId", "archive", "service"],
      "properties": {
        "requirementId": {"$ref": "#/$defs/id"},
        "selectorId": {"$ref": "#/$defs/id"},
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "bytes", "sha256"],
          "properties": {
            "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.zip$"},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 4000000},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactId", "name", "sizeInBytes", "digest", "runId", "runAttempt", "runUrl"],
          "properties": {
            "artifactId": {"type": "string", "pattern": "^[1-9][0-9]{0,63}$"},
            "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
            "sizeInBytes": {"type": "integer", "minimum": 1, "maximum": 4000000},
            "digest": {"$ref": "#/$defs/sha256"},
            "runId": {"type": "string", "pattern": "^[1-9][0-9]{0,63}$"},
            "runAttempt": {"type": "integer", "minimum": 1, "maximum": 1000},
            "runUrl": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 1}}, "required": ["schemaVersion"]},
      "then": {"not": {"required": ["authorityTransition"]}}
    },
    {
      "if": {"properties": {"schemaVersion": {"const": 2}}, "required": ["schemaVersion"]},
      "then": {"required": ["authorityTransition"]}
    }
  ]
}
