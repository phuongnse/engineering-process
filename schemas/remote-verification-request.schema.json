{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/remote-verification-request.schema.json",
  "title": "Exact-checkpoint remote verification request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "changeId",
    "cycle",
    "project",
    "checkpoint",
    "comparisonBase",
    "workspaceFingerprint",
    "createdAt",
    "requirements",
    "controls"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "engineering-process-remote-verification-request"},
    "changeId": {"$ref": "#/$defs/id"},
    "cycle": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "project": {"$ref": "#/$defs/project"},
    "checkpoint": {"$ref": "#/$defs/gitOid"},
    "comparisonBase": {"$ref": "#/$defs/gitOid"},
    "workspaceFingerprint": {"$ref": "#/$defs/sha256"},
    "createdAt": {"type": "string", "format": "date-time"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/requirement"}
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grantsAdoption",
        "grantsDeployment",
        "grantsLifecycleCompletion",
        "grantsMerge",
        "grantsRelease",
        "grantsReview"
      ],
      "properties": {
        "grantsAdoption": {"const": false},
        "grantsDeployment": {"const": false},
        "grantsLifecycleCompletion": {"const": false},
        "grantsMerge": {"const": false},
        "grantsRelease": {"const": false},
        "grantsReview": {"const": false}
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "project": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "gitOid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profiles", "execution", "selectors"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "repository", "workflow", "workflowRef", "workflowSha"],
          "properties": {
            "provider": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"},
            "repository": {"type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
            "workflow": {"type": "string", "minLength": 1, "maxLength": 256},
            "workflowRef": {"type": "string", "minLength": 1, "maxLength": 512},
            "workflowSha": {"$ref": "#/$defs/gitOid"}
          }
        },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/selector"}
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runnerOs", "implementation", "pythonMinor"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "runnerOs": {"type": "string", "minLength": 1, "maxLength": 64},
        "runnerArch": {"type": "string", "minLength": 1, "maxLength": 64},
        "implementation": {"type": "string", "minLength": 1, "maxLength": 64},
        "pythonMinor": {"type": "string", "pattern": "^3\\.(?:11|12|13|14)$"}
      }
    }
  }
}
