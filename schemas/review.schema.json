{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/review.schema.json",
  "title": "Independent review report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeId", "reviewer", "checkpoint", "verdict", "summary", "findings"],
  "properties": {
    "schemaVersion": {"const": 5},
    "changeId": {"$ref": "#/$defs/id"},
    "reviewer": {"$ref": "#/$defs/actor"},
    "checkpoint": {"$ref": "#/$defs/checkpoint"},
    "verdict": {"enum": ["approved", "changes-requested"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "findings": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "priority", "criterionId", "origin", "summary"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "severity": {"enum": ["blocking", "non-blocking"]},
          "priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "criterionId": {"$ref": "#/$defs/id"},
          "origin": {"enum": ["contract", "remediation-regression", "critical-late"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
          "location": {"type": "string", "minLength": 1, "maxLength": 1000},
          "lateRationale": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "contextId", "kind"],
      "properties": {
        "actorId": {"type": "string", "minLength": 1, "maxLength": 200},
        "contextId": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {"enum": ["agent", "human"]}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "fingerprint", "fileCount", "byteCount"],
      "properties": {
        "head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
        "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "fileCount": {"type": "integer", "minimum": 0},
        "byteCount": {"type": "integer", "minimum": 0}
      }
    }
  }
}
