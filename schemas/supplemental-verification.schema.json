{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/supplemental-verification.schema.json",
  "title": "Engineering supplemental verification manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "checkpoint",
    "comparisonBase",
    "workspaceFingerprint",
    "startedAt",
    "completedAt",
    "producer",
    "execution",
    "platform",
    "runtime",
    "reports"
  ],
  "properties": {
    "schemaVersion": {"enum": [1, 2]},
    "kind": {"const": "engineering-process-supplemental-verification"},
    "status": {"enum": ["passed", "failed"]},
    "checkpoint": {"$ref": "#/$defs/gitOid"},
    "comparisonBase": {"$ref": "#/$defs/gitOid"},
    "workspaceFingerprint": {"$ref": "#/$defs/sha256"},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "contextId", "kind"],
      "properties": {
        "actorId": {"type": "string", "minLength": 1, "maxLength": 128},
        "contextId": {"type": "string", "minLength": 1, "maxLength": 512},
        "kind": {"const": "automation"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository",
        "event",
        "workflow",
        "workflowRef",
        "workflowSha",
        "runId",
        "runAttempt",
        "job",
        "runUrl",
        "triggeredBy"
      ],
      "properties": {
        "provider": {"$ref": "#/$defs/safeName"},
        "repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "event": {"$ref": "#/$defs/safeName"},
        "workflow": {"type": "string", "minLength": 1, "maxLength": 256},
        "workflowRef": {"type": "string", "minLength": 1, "maxLength": 512},
        "workflowSha": {"$ref": "#/$defs/gitOid"},
        "runId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,63}$"
        },
        "runAttempt": {"type": "integer", "minimum": 1, "maximum": 1000},
        "job": {"$ref": "#/$defs/safeName"},
        "runUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "triggeredBy": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runnerOs",
        "runnerArch",
        "sysPlatform",
        "system",
        "release",
        "machine"
      ],
      "properties": {
        "runnerOs": {"type": "string", "minLength": 1, "maxLength": 64},
        "runnerArch": {"type": "string", "minLength": 1, "maxLength": 64},
        "sysPlatform": {"type": "string", "minLength": 1, "maxLength": 64},
        "system": {"type": "string", "minLength": 1, "maxLength": 64},
        "release": {"type": "string", "minLength": 1, "maxLength": 256},
        "machine": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "pythonVersion", "cacheTag"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1, "maxLength": 64},
        "pythonVersion": {
          "type": "string",
          "pattern": "^3\\.(?:11|12|13|14)\\.[0-9]+$",
          "maxLength": 32
        },
        "cacheTag": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/report"}
    }
  },
  "$defs": {
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hexSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "exitCode",
        "startedAt",
        "durationMs",
        "timeoutSeconds",
        "commandSha256",
        "impactSha256",
        "impactIntegrity",
        "stdoutBytes",
        "stderrBytes",
        "stdoutSha256",
        "stderrSha256",
        "outputTruncated",
        "streamOutputTruncated"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "status": {
          "enum": ["passed", "failed", "timed-out", "failed-to-start"]
        },
        "exitCode": {"type": ["integer", "null"]},
        "startedAt": {"type": "string", "format": "date-time"},
        "durationMs": {"type": "integer", "minimum": 0},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "commandSha256": {"$ref": "#/$defs/hexSha256"},
        "impactSha256": {"$ref": "#/$defs/hexSha256"},
        "impactIntegrity": {"enum": ["verified", "failed"]},
        "stdoutBytes": {"type": "integer", "minimum": 0},
        "stderrBytes": {"type": "integer", "minimum": 0},
        "stdoutSha256": {"$ref": "#/$defs/hexSha256"},
        "stderrSha256": {"$ref": "#/$defs/hexSha256"},
        "outputTruncated": {"type": "boolean"},
        "streamOutputTruncated": {"type": "boolean"},
        "diagnostics": {"$ref": "#/$defs/diagnostics"}
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "status",
        "count",
        "matches",
        "matchesTruncated"
      ],
      "properties": {
        "policy": {"const": "forbid-warning-error"},
        "status": {"enum": ["clean", "failed"]},
        "count": {"type": "integer", "minimum": 0},
        "matches": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "stream", "line", "lineSha256"],
            "properties": {
              "severity": {"enum": ["warning", "error"]},
              "stream": {"enum": ["stdout", "stderr"]},
              "line": {"type": "integer", "minimum": 1},
              "lineSha256": {"$ref": "#/$defs/hexSha256"}
            }
          }
        },
        "matchesTruncated": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "clean"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "count": {"const": 0},
              "matches": {"maxItems": 0},
              "matchesTruncated": {"const": false}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "failed"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "count": {"minimum": 1},
              "matches": {"minItems": 1}
            }
          }
        }
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "schemaVersion",
        "profile",
        "status",
        "checkpoint",
        "workspaceFingerprint",
        "completedWorkspaceFingerprint",
        "impact",
        "checks"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.json$",
          "maxLength": 70
        },
        "bytes": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schemaVersion": {"enum": [2, 3]},
        "profile": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "maxLength": 64
        },
        "status": {"enum": ["passed", "failed"]},
        "checkpoint": {"$ref": "#/$defs/gitOid"},
        "workspaceFingerprint": {"$ref": "#/$defs/sha256"},
        "completedWorkspaceFingerprint": {"$ref": "#/$defs/sha256"},
        "impact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "selectedCheckIds",
            "skippedCheckIds",
            "sha256"
          ],
          "properties": {
            "mode": {"enum": ["full-profile", "affected-checks"]},
            "selectedCheckIds": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {"type": "string", "maxLength": 64}
            },
            "skippedCheckIds": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {"type": "string", "maxLength": 64}
            },
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "checks": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/check"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schemaVersion": {"const": 1}},
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "reports": {
            "items": {
              "properties": {
                "schemaVersion": {"const": 2},
                "checks": {
                  "items": {"not": {"required": ["diagnostics"]}}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schemaVersion": {"const": 2}},
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "reports": {
            "items": {
              "properties": {
                "schemaVersion": {"const": 3},
                "checks": {
                  "items": {"required": ["diagnostics"]}
                }
              }
            }
          }
        }
      }
    }
  ]
}
