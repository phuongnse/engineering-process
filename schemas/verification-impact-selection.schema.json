{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/verification-impact-selection.schema.json",
  "title": "Verification impact selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "changeId",
    "status",
    "comparisonBaseCommit",
    "changedPaths",
    "requirements",
    "selectedUnits",
    "unresolvedPaths"
  ],
  "properties": {
    "schemaVersion": {"enum": [1, 2]},
    "changeId": {"$ref": "#/$defs/id"},
    "status": {"enum": ["ready", "unresolved", "unavailable"]},
    "comparisonBaseCommit": {"$ref": "#/$defs/commit"},
    "policyDigest": {"$ref": "#/$defs/digest"},
    "assuranceProfiles": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "changedPaths": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/path"}
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "status", "selectedUnits", "unresolvedPaths"],
        "properties": {
          "profile": {"$ref": "#/$defs/id"},
          "status": {"enum": ["ready", "unresolved", "unavailable"]},
          "selectedUnits": {
            "type": "array",
            "maxItems": 64,
            "items": {"$ref": "#/$defs/unit"}
          },
          "unresolvedPaths": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/path"}
          },
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "selectedUnits": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/unit"}
    },
    "unresolvedPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "path"],
        "properties": {
          "profile": {"$ref": "#/$defs/id"},
          "path": {"$ref": "#/$defs/path"}
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reason", "paths"],
      "properties": {
        "action": {"const": "inspect-diff-and-update-impact-policy"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schemaVersion": {"const": 2}},
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["policyDigest", "assuranceProfiles"]
      }
    },
    {
      "if": {"properties": {"status": {"const": "ready"}}, "required": ["status"]},
      "then": {"properties": {"unresolvedPaths": {"maxItems": 0}}, "not": {"required": ["resolution"]}}
    },
    {
      "if": {"properties": {"status": {"enum": ["unresolved", "unavailable"]}}, "required": ["status"]},
      "then": {"required": ["resolution"]}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "id", "matchedPaths"],
      "properties": {
        "profile": {"$ref": "#/$defs/id"},
        "id": {"$ref": "#/$defs/id"},
        "matchedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        }
      }
    }
  }
}
