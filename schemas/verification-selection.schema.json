{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/verification-selection.schema.json",
  "title": "Verification selection explanation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeId", "phase", "status", "checkpoint", "requirements", "executeProfiles", "reuseProfiles", "inapplicableProfiles", "blockedProfiles", "diagnostics"],
  "properties": {
    "schemaVersion": {"const": 1},
    "changeId": {"$ref": "#/$defs/id"},
    "phase": {"enum": ["specified", "planned", "implementing", "verified", "review-pending", "approved", "changes-requested", "completed", "blocked"]},
    "status": {"enum": ["ready", "blocked"]},
    "checkpoint": {"$ref": "#/$defs/checkpoint"},
    "requirements": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/requirement"}
    },
    "executeProfiles": {"$ref": "#/$defs/profileList"},
    "reuseProfiles": {"$ref": "#/$defs/profileList"},
    "inapplicableProfiles": {"$ref": "#/$defs/profileList"},
    "blockedProfiles": {"$ref": "#/$defs/profileList"},
    "diagnostics": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/diagnostic"}
    },
    "assuranceProfiles": {"$ref": "#/$defs/profileList"},
    "assuranceSelectionDigest": {"$ref": "#/$defs/digest"},
    "assurancePolicyDigest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"required": ["assuranceProfiles"]},
      "then": {"required": ["assuranceSelectionDigest", "assurancePolicyDigest"]}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "fingerprint", "fileCount", "byteCount"],
      "properties": {
        "head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
        "fingerprint": {"$ref": "#/$defs/digest"},
        "fileCount": {"type": "integer", "minimum": 0},
        "byteCount": {"type": "integer", "minimum": 0}
      }
    },
    "profileList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint", "recordedAt"],
      "properties": {
        "checkpoint": {"$ref": "#/$defs/checkpoint"},
        "recordedAt": {"type": "string", "format": "date-time"},
        "inputDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "status", "action", "reason"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "profile": {"$ref": "#/$defs/id"},
        "status": {"enum": ["remaining", "satisfied", "inapplicable", "blocked", "unknown"]},
        "action": {"enum": ["execute", "reuse", "skip", "blocked"]},
        "mode": {"enum": ["full", "impact-assurance"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence": {"$ref": "#/$defs/evidence"},
        "diagnostic": {"$ref": "#/$defs/diagnostic"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "status", "reportDigest", "runPath", "cycle", "checkpoint", "recordedAt", "reason"],
      "properties": {
        "profile": {"$ref": "#/$defs/id"},
        "status": {"enum": ["current", "stale", "unavailable"]},
        "reportDigest": {"$ref": "#/$defs/digest"},
        "runPath": {"type": "string", "minLength": 1, "maxLength": 4096},
        "cycle": {"type": "integer", "minimum": 1},
        "checkpoint": {"$ref": "#/$defs/checkpoint"},
        "recordedAt": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "kind": {"const": "selective-check-reproduction"},
        "check": {"$ref": "#/$defs/id"},
        "position": {"type": "integer", "minimum": 1, "maximum": 32},
        "command": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {"const": "processctl"},
            {"const": "verify"},
            {"const": "--profile"},
            {"$ref": "#/$defs/id"},
            {"const": "--check-position"},
            {"type": "string", "pattern": "^(?:[1-9]|[12][0-9]|3[0-2])$"}
          ],
          "items": false
        },
        "failureKind": {"enum": ["command-failure", "execution-condition", "unknown"]},
        "failure": {"$ref": "#/$defs/failureSummary"}
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256", "truncated"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/digest"},
        "truncated": {"type": "boolean"}
      }
    },
    "failureSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exitCode", "timedOut", "outputExceeded", "descendantsTerminated", "streamFailed", "durationMs", "stdout", "stderr"],
      "properties": {
        "status": {"const": "failed"},
        "exitCode": {"type": "integer"},
        "timedOut": {"type": "boolean"},
        "outputExceeded": {"type": "boolean"},
        "descendantsTerminated": {"type": "boolean"},
        "streamFailed": {"type": "boolean"},
        "cleanupFailed": {"type": "boolean"},
        "durationMs": {"type": "integer", "minimum": 0},
        "stdout": {"$ref": "#/$defs/stream"},
        "stderr": {"$ref": "#/$defs/stream"}
      }
    }
  }
}
