{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/verification.schema.json",
  "title": "Engineering verification report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "profile",
    "checkpoint",
    "workingTreeDirty",
    "workspaceFingerprint",
    "completedWorkspaceFingerprint",
    "sourceChangedDuringVerification",
    "startedAt",
    "completedAt",
    "status",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "checkpoint": {
      "type": ["string", "null"]
    },
    "workingTreeDirty": {
      "type": ["boolean", "null"]
    },
    "workspaceFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "completedWorkspaceFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceChangedDuringVerification": {
      "type": "boolean"
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mode",
        "profile",
        "selectedCheckIds",
        "skippedCheckIds",
        "checkSelection"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "mode": {"enum": ["full-profile", "affected-checks"]},
        "profile": {"type": "string"},
        "baseRef": {"type": "string"},
        "baseCommit": {"type": "string"},
        "headCommit": {"type": "string"},
        "mergeBase": {"type": "string"},
        "changedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "directlyChangedComponents": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "affectedComponents": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "unmatchedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "selectedCheckIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "skippedCheckIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "checkSelection": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "selected",
              "reason",
              "components",
              "matchedComponents"
            ],
            "properties": {
              "id": {"type": "string"},
              "selected": {"type": "boolean"},
              "reason": {
                "enum": [
                  "profile-has-no-impact-contract",
                  "unscoped-always-run",
                  "unmatched-path-fallback",
                  "affected-component",
                  "no-affected-component"
                ]
              },
              "components": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string"}
              },
              "matchedComponents": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string"}
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"mode": {"const": "affected-checks"}},
            "required": ["mode"]
          },
          "then": {
            "required": [
              "baseRef",
              "baseCommit",
              "headCommit",
              "mergeBase",
              "changedPaths",
              "directlyChangedComponents",
              "affectedComponents",
              "unmatchedPaths"
            ]
          }
        }
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["passed", "failed"]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "exitCode",
          "startedAt",
          "durationMs",
          "workingDirectory",
          "command",
          "commandSha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": ["passed", "failed", "timed-out", "failed-to-start"]
          },
          "exitCode": {
            "type": ["integer", "null"]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "workingDirectory": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "commandSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "pathEntries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
