{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/verification.schema.json",
  "title": "Engineering verification report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "profile",
    "checkpoint",
    "workingTreeDirty",
    "workspaceFingerprint",
    "completedWorkspaceFingerprint",
    "sourceChangedDuringVerification",
    "startedAt",
    "completedAt",
    "status",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2, 3]
    },
    "project": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "checkpoint": {
      "type": ["string", "null"]
    },
    "workingTreeDirty": {
      "type": ["boolean", "null"]
    },
    "workspaceFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "completedWorkspaceFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceChangedDuringVerification": {
      "type": "boolean"
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mode",
        "profile",
        "selectedCheckIds",
        "skippedCheckIds",
        "checkSelection"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "mode": {"enum": ["full-profile", "affected-checks"]},
        "profile": {"type": "string"},
        "baseRef": {"type": "string"},
        "baseCommit": {"type": "string"},
        "headCommit": {"type": "string"},
        "mergeBase": {"type": "string"},
        "changedPaths": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "directlyChangedComponents": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "affectedComponents": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "unmatchedPaths": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "selectedCheckIds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "skippedCheckIds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "checkSelection": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "selected",
              "reason",
              "components",
              "matchedComponents"
            ],
            "properties": {
              "id": {"type": "string"},
              "selected": {"type": "boolean"},
              "reason": {
                "enum": [
                  "profile-has-no-impact-contract",
                  "unscoped-always-run",
                  "unmatched-path-fallback",
                  "affected-component",
                  "no-affected-component"
                ]
              },
              "components": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string"}
              },
              "matchedComponents": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string"}
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"mode": {"const": "affected-checks"}},
            "required": ["mode"]
          },
          "then": {
            "required": [
              "baseRef",
              "baseCommit",
              "headCommit",
              "mergeBase",
              "changedPaths",
              "directlyChangedComponents",
              "affectedComponents",
              "unmatchedPaths"
            ]
          }
        }
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["passed", "failed"]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "exitCode",
          "startedAt",
          "durationMs",
          "workingDirectory",
          "command",
          "commandSha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": ["passed", "failed", "timed-out", "failed-to-start"]
          },
          "exitCode": {
            "type": ["integer", "null"]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "workingDirectory": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "commandSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "impactSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "impactIntegrity": {
            "enum": ["verified", "failed"]
          },
          "stdoutBytes": {
            "type": "integer",
            "minimum": 0
          },
          "stderrBytes": {
            "type": "integer",
            "minimum": 0
          },
          "stdoutSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "stderrSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "diagnostics": {
            "$ref": "#/$defs/diagnostics"
          },
          "outputTruncated": {
            "type": "boolean"
          },
          "streamOutputTruncated": {
            "type": "boolean"
          },
          "pathEntries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "status",
        "count",
        "matches",
        "matchesTruncated"
      ],
      "properties": {
        "policy": {"const": "forbid-warning-error"},
        "status": {"enum": ["clean", "failed"]},
        "count": {"type": "integer", "minimum": 0},
        "matches": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "stream", "line", "lineSha256"],
            "properties": {
              "severity": {"enum": ["warning", "error"]},
              "stream": {"enum": ["stdout", "stderr"]},
              "line": {"type": "integer", "minimum": 1},
              "lineSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "matchesTruncated": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "clean"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "count": {"const": 0},
              "matches": {"maxItems": 0},
              "matchesTruncated": {"const": false}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "failed"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "count": {"minimum": 1},
              "matches": {"minItems": 1}
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schemaVersion": {"const": 1}},
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "checks": {
            "minItems": 1,
            "items": {"not": {"required": ["diagnostics"]}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schemaVersion": {"const": 2}},
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["impact"],
        "properties": {
          "checks": {
            "maxItems": 256,
            "items": {
              "not": {"required": ["diagnostics"]},
              "properties": {
                "command": {"maxItems": 256}
              },
              "required": [
                "impactSha256",
                "impactIntegrity",
                "stdoutBytes",
                "stderrBytes",
                "stdoutSha256",
                "stderrSha256",
                "outputTruncated",
                "streamOutputTruncated"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schemaVersion": {"const": 3}},
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["impact"],
        "properties": {
          "checks": {
            "maxItems": 256,
            "items": {
              "properties": {
                "command": {"maxItems": 256}
              },
              "required": [
                "impactSha256",
                "impactIntegrity",
                "stdoutBytes",
                "stderrBytes",
                "stdoutSha256",
                "stderrSha256",
                "diagnostics",
                "outputTruncated",
                "streamOutputTruncated"
              ]
            }
          }
        }
      }
    }
  ]
}
