{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/verification.schema.json",
  "title": "Engineering verification report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "profile",
    "checkpoint",
    "workingTreeDirty",
    "workspaceFingerprint",
    "completedWorkspaceFingerprint",
    "sourceChangedDuringVerification",
    "startedAt",
    "completedAt",
    "status",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2]
    },
    "project": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "checkpoint": {
      "type": ["string", "null"]
    },
    "workingTreeDirty": {
      "type": ["boolean", "null"]
    },
    "workspaceFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "completedWorkspaceFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceChangedDuringVerification": {
      "type": "boolean"
    },
    "sourceStateDiagnostics": {
      "$ref": "#/$defs/sourceStateDiagnostics"
    },
    "completedSourceStateDiagnostics": {
      "$ref": "#/$defs/sourceStateDiagnostics"
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mode",
        "profile",
        "selectedCheckIds",
        "skippedCheckIds",
        "checkSelection"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "mode": {"enum": ["full-profile", "affected-checks"]},
        "profile": {"type": "string"},
        "baseRef": {"type": "string"},
        "baseCommit": {"type": "string"},
        "headCommit": {"type": "string"},
        "mergeBase": {"type": "string"},
        "changedPaths": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "directlyChangedComponents": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "affectedComponents": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "unmatchedPaths": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "selectedCheckIds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "skippedCheckIds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "checkSelection": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "selected",
              "reason",
              "components",
              "matchedComponents"
            ],
            "properties": {
              "id": {"type": "string"},
              "selected": {"type": "boolean"},
              "reason": {
                "enum": [
                  "profile-has-no-impact-contract",
                  "unscoped-always-run",
                  "unmatched-path-fallback",
                  "affected-component",
                  "no-affected-component"
                ]
              },
              "components": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string"}
              },
              "matchedComponents": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string"}
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"mode": {"const": "affected-checks"}},
            "required": ["mode"]
          },
          "then": {
            "required": [
              "baseRef",
              "baseCommit",
              "headCommit",
              "mergeBase",
              "changedPaths",
              "directlyChangedComponents",
              "affectedComponents",
              "unmatchedPaths"
            ]
          }
        }
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["passed", "failed"]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "exitCode",
          "startedAt",
          "durationMs",
          "workingDirectory",
          "command",
          "commandSha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": ["passed", "failed", "timed-out", "failed-to-start"]
          },
          "exitCode": {
            "type": ["integer", "null"]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "workingDirectory": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "commandSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "impactSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "impactIntegrity": {
            "enum": ["verified", "failed"]
          },
          "stdoutBytes": {
            "type": "integer",
            "minimum": 0
          },
          "stderrBytes": {
            "type": "integer",
            "minimum": 0
          },
          "stdoutSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "stderrSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "outputTruncated": {
            "type": "boolean"
          },
          "streamOutputTruncated": {
            "type": "boolean"
          },
          "pathEntries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sourceStateDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issues",
        "ignoredBytecodeSha256",
        "trackedIndexSha256",
        "statusSha256",
        "diffSha256",
        "untrackedSha256",
        "untrackedPathCount",
        "untrackedBytes"
      ],
      "properties": {
        "issues": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/sourceStateIssue"}
        },
        "ignoredBytecodeSha256": {"$ref": "#/$defs/nullableDigest"},
        "trackedIndexSha256": {"$ref": "#/$defs/nullableDigest"},
        "statusSha256": {"$ref": "#/$defs/nullableDigest"},
        "diffSha256": {"$ref": "#/$defs/nullableDigest"},
        "untrackedSha256": {"$ref": "#/$defs/nullableDigest"},
        "untrackedPathCount": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 5000
        },
        "untrackedBytes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 32000000
        }
      }
    },
    "sourceStateIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "command",
        "failureKind",
        "exitCode",
        "stderr",
        "stderrBytes",
        "stderrSha256",
        "stderrTruncated",
        "error",
        "errorBytes",
        "errorSha256",
        "errorTruncated"
      ],
      "properties": {
        "operation": {
          "enum": [
            "ignored-sourceless-bytecode",
            "tracked-index",
            "status",
            "head",
            "tracked-diff",
            "untracked-paths"
          ]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "string", "maxLength": 512}
        },
        "failureKind": {"enum": ["nonzero-exit", "execution-error"]},
        "exitCode": {"type": ["integer", "null"]},
        "stderr": {"type": "string", "maxLength": 4096},
        "stderrBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "stderrSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stderrTruncated": {"type": "boolean"},
        "error": {"type": "string", "maxLength": 4096},
        "errorBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "errorSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "errorTruncated": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"failureKind": {"const": "nonzero-exit"}},
            "required": ["failureKind"]
          },
          "then": {
            "properties": {
              "exitCode": {"type": "integer"},
              "error": {"const": ""},
              "errorBytes": {"const": 0},
              "errorSha256": {
                "const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
              },
              "errorTruncated": {"const": false}
            }
          }
        },
        {
          "if": {
            "properties": {"failureKind": {"const": "execution-error"}},
            "required": ["failureKind"]
          },
          "then": {
            "properties": {
              "exitCode": {"type": "null"},
              "stderr": {"const": ""},
              "stderrBytes": {"const": 0},
              "stderrSha256": {
                "const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
              },
              "stderrTruncated": {"const": false},
              "error": {"minLength": 1},
              "errorBytes": {"minimum": 1}
            }
          }
        }
      ]
    },
    "nullableDigest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schemaVersion": {"const": 1}},
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "checks": {"minItems": 1}
        },
        "not": {
          "anyOf": [
            {"required": ["sourceStateDiagnostics"]},
            {"required": ["completedSourceStateDiagnostics"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {"schemaVersion": {"const": 2}},
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["impact"],
        "properties": {
          "checks": {
            "maxItems": 256,
            "items": {
              "properties": {
                "command": {"maxItems": 256}
              },
              "required": [
                "impactSha256",
                "impactIntegrity",
                "stdoutBytes",
                "stderrBytes",
                "stdoutSha256",
                "stderrSha256",
                "outputTruncated",
                "streamOutputTruncated"
              ]
            }
          }
        }
      }
    }
  ]
}
