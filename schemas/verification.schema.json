{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-process.invalid/schemas/verification.schema.json",
  "title": "Engineering verification report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "profile",
    "checkpoint",
    "workingTreeDirty",
    "workspaceFingerprint",
    "completedWorkspaceFingerprint",
    "sourceChangedDuringVerification",
    "startedAt",
    "completedAt",
    "status",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "checkpoint": {
      "type": ["string", "null"]
    },
    "workingTreeDirty": {
      "type": ["boolean", "null"]
    },
    "workspaceFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "completedWorkspaceFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceChangedDuringVerification": {
      "type": "boolean"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["passed", "failed"]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "exitCode",
          "startedAt",
          "durationMs",
          "workingDirectory",
          "command",
          "commandSha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": ["passed", "failed", "timed-out", "failed-to-start"]
          },
          "exitCode": {
            "type": ["integer", "null"]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "workingDirectory": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "commandSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "pathEntries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
